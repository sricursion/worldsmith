      "name": "Reset Key",
      "description": "A worn hex key for the mast's reset panel. Scratched with survey marks.",
      "holder": "scout_vey"
    },
    {
      "id": "climb_harness",
      "name": "Climb Harness",
      "description": "Patched webbing and two carabiners. Smells of old lubricant.",
