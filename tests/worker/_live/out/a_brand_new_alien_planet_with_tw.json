  "npcs": [
    {
      "id": "scout_vey",
      "name": "Vey",
      "role": "survey scout",
      "persona": "Dry, watchful, short on patience since the mast went quiet. Wants the beacon live before the next drift cuts the post off for good.",
      "knowledge": [
        "The mast went dead the day a float-rock sank to within a spear-throw of the top.",
        "The reset panel sits under the lamp housing, near the summit.",
        "Float-rocks rise and sink with the twin suns' heat, so the climb must be done before dusk."
      ],
      "secrets": [
        "Vey logged the rock's descent two days early and said nothing, hoping it would pass."
      ],
      "home": "survey_hut",
      "work": "beacon_mast",
      "schedule": [
        {
          "hour": 6,
          "place": "survey_hut",
          "activity": "eat"
        },
