    },
    {
      "id": "float_shard",
      "name": "Float-Rock Shard",
      "description": "A palm-sized shard that tugs gently upward in the hand. Useful as proof of how low the island hung.",
      "holder": "beacon_mast"
    }
  ],
  "quest": {
    "id": "silent_mast",
    "title": "The Silent Mast",
    "hook": "The Signal Mast on the ridge has gone dark since a float-rock drifted too low and clipped its lattice. Vey can't make the climb with a bad shoulder, and the survey needs a beacon before the next drift closes the pass. She needs a stranger with a steady hand and a head for heights, and she needs them before the second sun sets.",
    "giver": "scout_vey",
    "steps": [
      {
        "id": "s1_talk",
        "kind": "talk",
        "target": "scout_vey",
        "requires": [],
        "objective": "Hear Vey out about the dead mast.",
        "beat": "Vey points at the mast, silent against the violet haze, and explains what she needs done."
      },
      {
        "id": "s2_harness",
        "kind": "fetch",
        "target": "climb_harness",
        "requires": [
          "s1_talk"
        ],
        "objective": "Take the climb harness from the Ridge Survey Post.",
        "beat": "The harness hangs by the door, stiff with grit. Overhead, drifter hawks circle the low rock.",
        "item": "climb_harness"
      },
      {
        "id": "s3_key",
        "kind": "talk",
        "target": "scout_vey",
        "requires": [
          "s2_harness"
        ],
        "objective": "Get the reset key from Vey.",
        "beat": "Vey hands over the key and admits she saw the rock sinking two days ago and kept quiet.",
        "reveals": [
          "scout_vey:0"
        ]
      },
      {
        "id": "s4_climb",
        "kind": "visit",
        "target": "beacon_mast",
        "requires": [
          "s3_key"
        ],
        "objective": "Climb the Signal Mast and reset the panel.",
        "beat": "The lattice hums with static. Up top, the float-rock hangs close enough to touch. The panel clicks, and the beacon lamp wakes."
      },
      {
        "id": "s5_shard",
        "kind": "fetch",
        "target": "float_shard",
        "requires": [
          "s4_climb"
        ],
        "objective": "Pick up the float-rock shard wedged in the lattice.",
        "beat": "A sheared piece of the island, still pulling upward. Proof of how close it came.",
        "item": "float_shard"
      },
      {
        "id": "s6_return",
        "kind": "deliver",
        "target": "scout_vey",
        "requires": [
          "s5_shard"
        ],
        "objective": "Bring the shard back to Vey.",
        "beat": "Vey turns the shard in her hands, then logs it. The beacon pulses overhead, and the pass is open again.",
        "item": "float_shard"
      }
    ],
    "endings": [
      {
        "stepId": "s6_return",
        "label": "The beacon burns again and the survey post is saved.",
        "tone": "good"
      }
    ]
  },
  "rules": [
    {
      "id": "r_no_fire",
      "text": "Nobody lights open flame near the mast; the lattice is coated in static-bleed paint.",
      "effect": {
        "type": "ban",
        "what": "open flame",
        "where": "beacon_mast"
      },
      "source": "world"
    },
    {
      "id": "r_drift_custom",
      "text": "Scouts leave the ridge before the second sun sets, when the float-rocks sink lowest.",
      "effect": {
        "type": "custom",
        "summary": "Nobody stays on the ridge after the second sun sets; the drift is lowest then."
      },
      "source": "world"
    }
  ],
