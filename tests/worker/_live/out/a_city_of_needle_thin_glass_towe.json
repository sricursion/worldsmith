  "quest": {
    "id": "restore_the_light",
    "title": "The Dark Beacon of Vantage Spire",
    "hook": "Three nights ago the beacon on Vantage Spire died, and the upper needles have drifted blind in the rain. Sele Ardent needs a runner willing to climb the Signal Mast and wake the light before a freighter hits a tower.",
    "giver": "sele",
    "steps": [
      {
        "id": "s1_brief",
        "kind": "talk",
        "target": "sele",
        "requires": [],
        "objective": "Speak to Sele Ardent at Vantage Spire.",
        "beat": "Sele explains the beacon failure and hands over the mast key."
      },
      {
        "id": "s2_harness",
        "kind": "fetch",
        "target": "climb_harness",
        "requires": [
          "s1_brief"
        ],
        "objective": "Collect the climbing harness at Gantry Yard.",
        "beat": "Teg hands over the harness and warns about the slick rungs.",
        "item": "climb_harness",
        "reveals": [
          "teg:0"
        ]
      },
      {
        "id": "s3_coil",
        "kind": "fetch",
        "target": "relay_coil",
        "requires": [
          "s1_brief"
        ],
        "objective": "Get a relay coil from Bram at Drift Market.",
        "beat": "Bram parts with the coil after some hard haggling.",
        "item": "relay_coil",
        "reveals": [
          "bram:0"
        ]
      },
      {
        "id": "s4_mast",
        "kind": "visit",
        "target": "signal_mast",
        "requires": [
          "s2_harness",
          "s3_coil"
        ],
        "objective": "Reach the foot of the Signal Mast.",
        "beat": "Mira watches you from the base, pale and silent."
      },
      {
        "id": "s5_choice",
        "kind": "choose",
        "target": "mira",
        "requires": [
          "s4_mast"
        ],
        "objective": "Decide what to do about Mira's secret.",
        "beat": "Mira confesses she rerouted the beacon power; you choose her fate.",
        "choices": [
          {
            "label": "Shield Mira and keep her secret",
            "unlocks": [
              "s6_quiet"
            ]
          },
          {
            "label": "Expose Mira to Sele",
            "unlocks": [
              "s6_expose"
            ]
          }
        ],
        "reveals": [
          "mira:0"
        ]
      },
      {
        "id": "s6_quiet",
        "kind": "deliver",
        "target": "mira",
        "requires": [
          "s5_choice"
        ],
        "objective": "Install the coil with Mira and relight the beacon.",
        "beat": "The beacon blazes red and the upper towers glow again.",
        "item": "relay_coil"
      },
      {
        "id": "s6_expose",
        "kind": "confront",
        "target": "sele",
        "requires": [
          "s5_choice"
        ],
        "objective": "Tell Sele the truth about Mira.",
        "beat": "Sele arrests Mira and relights the beacon herself.",
        "reveals": [
          "sele:0"
        ]
      }
    ],
    "endings": [
      {
        "stepId": "s6_quiet",
        "label": "The light returns and Mira keeps her place.",
        "tone": "good"
      },
      {
        "stepId": "s6_expose",
        "label": "The light returns, but Mira is taken away.",
        "tone": "bitter"
      }
