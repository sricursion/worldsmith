  "quest": {
    "id": "cold_nest",
    "title": "The Cold Nest of the Ashen Caldera",
    "hook": "The Ember Wyrm's nest has gone cold, and the kobolds whisper that it is hunting beyond the rim. The vents tremble under an eclipse sky, and soon the caldera will erupt. A stranger who owes no clan is needed to learn the truth before the lava rises.",
    "giver": "gorrik",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "gorrik",
        "requires": [],
        "objective": "Hear Gorrik's account of the cold hunting trails.",
        "beat": "Gorrik hands you a notched bone and tells you the Wyrm has not left its nest, though everyone swears it is hunting.",
        "reveals": [
          "gorrik:0"
        ]
      },
      {
        "id": "s2",
        "kind": "visit",
        "target": "cave_mouth",
        "requires": [
          "s1"
        ],
        "objective": "Check the Maw for any sign of the Wyrm's passing.",
        "beat": "The Maw is silent and sooty; no claw marks, no fresh kills, only cinder lizards scattering from the dark."
      },
      {
        "id": "s3",
        "kind": "visit",
        "target": "bone_nest",
        "requires": [
          "s2"
        ],
        "objective": "Climb to the nest while the Wyrm sleeps and look for what it left.",
        "beat": "The Ember Wyrm lies curled and unmoving, breathing slow and cold; a grey scale lies at the nest's edge."
      },
      {
        "id": "s4",
        "kind": "fetch",
        "target": "shed_scale",
        "requires": [
          "s3"
        ],
        "objective": "Take the ashen scale from the nest without waking the Wyrm.",
        "beat": "The scale is cold as river stone; the Wyrm stirs once, and the vents answer with a low groan.",
        "item": "shed_scale"
      },
      {
        "id": "s5",
        "kind": "talk",
        "target": "sizzi",
        "requires": [
          "s4"
        ],
        "objective": "Confront Sizzi with the scale and learn why she hid the Wyrm's sickness.",
        "beat": "Sizzi admits the Wyrm is ill and that she has fed the nest her own ember-coins to keep the vents from blowing.",
        "reveals": [
          "sizzi:0"
        ]
      },
      {
        "id": "s6",
        "kind": "choose",
        "target": "sizzi",
        "requires": [
          "s5"
        ],
        "objective": "Decide what to do with the truth.",
        "beat": "Gorrik's hunters want to cut the Wyrm down; Sizzi begs for time to heal it before the eclipse ends.",
        "choices": [
          {
            "label": "Tell Gorrik and let the hunters decide",
            "unlocks": [
              "s7a"
            ]
          },
          {
            "label": "Give Sizzi your ember-coin and keep the secret",
            "unlocks": [
              "s7b"
            ]
          }
        ]
      },
      {
        "id": "s7a",
        "kind": "deliver",
        "target": "gorrik",
        "requires": [
          "s6"
        ],
        "objective": "Bring the ashen scale to Gorrik as proof.",
        "beat": "Gorrik studies the grey scale in silence, then calls the hunters to the nest at dusk.",
        "item": "shed_scale"
      },
      {
        "id": "s7b",
        "kind": "deliver",
        "target": "sizzi",
        "requires": [
          "s6"
        ],
        "objective": "Hand Sizzi your ember-coin to rekindle the nest.",
        "beat": "The coin flares in the slag; the vents steady and the Wyrm's breath begins to warm.",
        "item": "ember_coin"
      }
    ],
    "endings": [
      {
        "stepId": "s7a",
        "label": "The hunters take the nest; the vents calm, but the Wyrm is gone.",
        "tone": "bitter"
      },
      {
        "stepId": "s7b",
        "label": "The nest rekindles and the Wyrm wakes to hunt again.",
        "tone": "good"
      }
    ]
  },
