  "quest": {
    "id": "fading_lamps",
    "title": "The Fading Lamps of Glowcap Hollow",
    "hook": "One by one the great lamp caps are going dark, and the lanternfolk of Glowcap Hollow fear the dimlands will swallow them. The sporelings are too small and too frightened to look for the cause themselves. They need a brave outsider who can walk the fog and ask hard questions.",
    "giver": "fenn",
    "steps": [
      {
        "id": "s1_warden",
        "kind": "talk",
        "target": "fenn",
        "requires": [],
        "objective": "Hear Fenn's plea at the Lamp Stalk.",
        "beat": "Fenn begs you to find why the lamps fade and hints Brin knows more."
      },
      {
        "id": "s2_tap",
        "kind": "fetch",
        "target": "copper_tap",
        "requires": [
          "s1_warden"
        ],
        "objective": "Take the copper tap from the Gill Forge.",
        "beat": "Brin growls but lets you take the stained tap; it was meant to draw light, not guard it.",
        "item": "copper_tap",
        "reveals": [
          "brin:0"
        ]
      },
      {
        "id": "s3_trench",
        "kind": "visit",
        "target": "root_house",
        "requires": [
          "s1_warden"
        ],
        "objective": "Visit Poll's Root Burrow and see the cold mycel.",
        "beat": "Poll shows you the grey trench he dug toward the north roots.",
        "reveals": [
          "poll:0"
        ]
      },
      {
        "id": "s4_confront",
        "kind": "confront",
        "target": "fenn",
        "requires": [
          "s2_tap",
          "s3_trench"
        ],
        "objective": "Confront Fenn with the copper tap.",
        "beat": "Fenn breaks down and admits he drained the great lamp to feed the smaller ones.",
        "reveals": [
          "fenn:0"
        ]
      },
      {
        "id": "s5_choose",
        "kind": "choose",
        "target": "mossa",
        "requires": [
          "s4_confront"
        ],
        "objective": "Decide with Mossa how to save the lamps.",
        "beat": "Mossa offers a seed of light, but it will cost the shrine's own glow.",
        "choices": [
          {
            "label": "Replant the seed at the Lamp Stalk",
            "unlocks": [
              "s6_restore"
            ]
          },
          {
            "label": "Seal the tap and let the lamps rest",
            "unlocks": [
              "s6_rest"
            ]
          }
        ],
        "reveals": [
          "mossa:0"
        ]
      },
      {
        "id": "s6_restore",
        "kind": "deliver",
        "target": "fenn",
        "requires": [
          "s5_choose"
        ],
        "objective": "Deliver the Seed of Light to Fenn at the Lamp Stalk.",
        "beat": "The great cap flares green-gold and the hollow cheers, though the shrine bowl goes dark.",
        "item": "seed_light"
      },
      {
        "id": "s6_rest",
        "kind": "talk",
        "target": "tilda",
        "requires": [
          "s5_choose"
        ],
        "objective": "Tell Tilda the lamps must rest in the dark.",
        "beat": "The hollow dims for a season, safe but gloomy, and Fenn is banished from the stalk.",
        "reveals": [
          "tilda:0"
        ]
      }
    ],
    "endings": [
      {
        "stepId": "s6_restore",
