  "quest": {
    "id": "silence_the_bell",
    "title": "The Bell That Tolls Itself",
    "hook": "The Cathedral bell rings every night with no hand on the rope, and each toll wakes the plague in another street. Brother Ansel needs a stranger with nothing to lose to climb the tower and silence it before the moon fully turns.",
    "giver": "brother_ansel",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "brother_ansel",
        "requires": [],
        "objective": "Hear Brother Ansel's plea at the Bell Tower.",
        "beat": "Ansel begs you to still the bell and says the tower door is locked; the key is with Rook."
      },
      {
        "id": "s2",
        "kind": "talk",
        "target": "rook_guard",
        "requires": [
          "s1"
        ],
        "objective": "Ask Rook at the Iron Gate for the tower key.",
        "beat": "Rook sizes you up and wants proof you mean no harm to the city.",
        "reveals": [
          "rook_guard:0"
        ]
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "bitter_salt",
        "requires": [
          "s2"
        ],
        "objective": "Collect the bitter salt from Maud's apothecary.",
        "beat": "Maud hands it over, eyeing you, and lets slip that Ansel has bought far too much of it.",
        "item": "bitter_salt",
        "reveals": [
          "maud:0"
        ]
      },
      {
        "id": "s4",
        "kind": "visit",
        "target": "clock_tower",
        "requires": [
          "s3"
        ],
        "objective": "Climb the tower while the crows watch from the sill.",
        "beat": "Crows shift on the belfry rail as the bell rocks above you, ringing with no hand on it."
      },
      {
        "id": "s5",
        "kind": "choose",
        "target": "brother_ansel",
        "requires": [
          "s4"
        ],
        "objective": "Decide how to end the bell.",
        "beat": "The clapper is packed with ash and wax. You can pin it silent or break it for good.",
        "choices": [
          {
            "label": "Pin the clapper with bitter salt and spare the bell",
            "unlocks": [
              "s6a"
            ]
          },
          {
            "label": "Smash the bell and let the ash fall",
            "unlocks": [
              "s6b"
            ]
          }
        ]
      },
      {
        "id": "s6a",
        "kind": "talk",
        "target": "brother_ansel",
        "requires": [
          "s5"
        ],
        "objective": "Tell Ansel the bell is hushed, not broken.",
        "beat": "The bell holds its tongue, but Ansel knows the ash still sleeps in the bronze."
      },
      {
        "id": "s6b",
        "kind": "confront",
        "target": "brother_ansel",
        "requires": [
          "s5"
        ],
        "objective": "Confront Ansel with the ash he cast into the bell.",
        "beat": "Ansel confesses and weeps as the broken bronze falls quiet at last.",
        "reveals": [
          "brother_ansel:0"
        ]
      }
    ],
    "endings": [
      {
        "stepId": "s6a",
        "label": "The bell is silenced, the sickness only sleeps.",
        "tone": "bitter"
      },
      {
        "stepId": "s6b",
        "label": "The bell is broken and the dead finally rest.",
        "tone": "good"
      }
    ]
  },
