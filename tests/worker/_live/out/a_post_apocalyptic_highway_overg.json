  "quest": {
    "id": "cut_the_green_lanes",
    "title": "The Green Lanes Are Shut",
    "hook": "Last winter the vines swallowed the eastbound lanes and the supply run died with them. Mara's stock is thinning, and the rains will be back soon. She needs someone with a vine-cutter and a strong back to open a path to Rest Stop 9.",
    "giver": "mara",
    "steps": [
      {
        "id": "s1_talk_mara",
        "kind": "talk",
        "target": "mara",
        "requires": [],
        "objective": "Hear Mara out at the Overpass Camp.",
        "beat": "Mara lays out the problem: shut lanes, thin stock, rain coming. She points you to the fuel stop for a blade."
      },
      {
        "id": "s2_fetch_cutter",
        "kind": "fetch",
        "target": "vine_cutter",
        "requires": [
          "s1_talk_mara"
        ],
        "objective": "Take the vine-cutter from the Gas Station Ruin.",
        "beat": "Under the collapsed canopy, past rusted pumps and roof vines, the blade hangs where Mara said. Crows watch from the beams.",
        "item": "vine_cutter"
      },
      {
        "id": "s3_talk_teo",
        "kind": "talk",
        "target": "teo",
        "requires": [
          "s2_fetch_cutter"
        ],
        "objective": "Ask Teo about the road east.",
        "beat": "Teo tells you the deer cross at dusk and the dogs hold Rest Stop 9. He studies the ground and says little else.",
        "reveals": [
          "teo:0"
        ]
      },
      {
        "id": "s4_visit_arch",
        "kind": "visit",
        "target": "bridge_arch",
        "requires": [
          "s3_talk_teo"
        ],
        "objective": "Cut through the vine curtains at Span Arch.",
        "beat": "The vines hang thick as curtains across the concrete arch. Each cut drops wet green ropes and opens a little more road."
      },
      {
        "id": "s5_visit_rest",
        "kind": "visit",
        "target": "rest_stop",
        "requires": [
          "s4_visit_arch"
        ],
        "objective": "Reach Rest Stop 9 past the feral dogs.",
        "beat": "The block shelter sits half-buried in ivy. Two feral dogs prowl the lot, watching you, and the path behind you is open."
      },
      {
        "id": "s6_fetch_collar",
        "kind": "fetch",
        "target": "dog_collar",
        "requires": [
          "s5_visit_rest"
        ],
        "objective": "Pick up the chewed collar the dogs left behind.",
        "beat": "In the dirt by the door lies a cracked collar, proof someone kept these dogs once. You pocket it while they circle.",
        "item": "dog_collar"
      },
      {
        "id": "s7_choose",
        "kind": "choose",
        "target": "mara",
        "requires": [
          "s6_fetch_collar"
        ],
        "objective": "Decide what to tell Mara about Rest Stop 9.",
        "beat": "The stores are sealed and the dogs guard them. You can report the road open and the stock safe, or admit the dogs make the place dangerous.",
        "choices": [
          {
            "label": "Report the road open and keep the dogs quiet",
            "unlocks": [
              "s8_good"
            ]
          },
          {
            "label": "Tell her the dogs hold the stop and no one is safe",
            "unlocks": [
              "s8_bitter"
            ]
          }
        ]
      },
      {
        "id": "s8_good",
        "kind": "talk",
        "target": "mara",
        "requires": [
          "s7_choose"
        ],
        "objective": "Give Mara the news that the road is open.",
        "beat": "Mara counts the scrip twice, then slides it over. The supply run can start before the rains come.",
        "reveals": [
          "mara:0"
        ]
      },
      {
        "id": "s8_bitter",
        "kind": "talk",
        "target": "mara",
        "requires": [
          "s7_choose"
        ],
        "objective": "Warn Mara about the dogs and the stop.",
        "beat": "Mara goes quiet, then mutters about rope she shouldn't have sold. The path is cut, but nobody wants to walk it.",
        "reveals": [
          "mara:0"
        ]
      }
    ],
    "endings": [
      {
        "stepId": "s8_good",
        "label": "The supply run reopens and the camp eats through the rains.",
        "tone": "good"
      },
      {
        "stepId": "s8_bitter",
        "label": "The lane is cut but the dogs keep Rest Stop 9, and the camp starves slowly.",
        "tone": "bitter"
      }
    ]
  },
