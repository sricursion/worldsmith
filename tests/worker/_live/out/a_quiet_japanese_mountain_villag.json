  "quest": {
    "id": "silent_bell",
    "title": "The Silent Bell of Kaede Hollow",
    "hook": "The bell at Hachiman Shrine has been silent since the autumn festival, and nobody in Kaede Hollow will say why. The old priest has a letter for the ridge and no one he can send. You are a stranger, and strangers are not bound by the valley's silence.",
    "giver": "priest",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "priest",
        "requires": [],
        "objective": "Hear the priest's request at the shrine.",
        "beat": "He hands you the errand without explaining the silence."
      },
      {
        "id": "s2",
        "kind": "fetch",
        "target": "sealed_letter",
        "requires": [
          "s1"
        ],
        "objective": "Take the sealed letter from the shrine altar.",
        "beat": "The wax is cold, and crows watch from the roof.",
        "item": "sealed_letter"
      },
      {
        "id": "s3",
        "kind": "talk",
        "target": "yamada",
        "requires": [
          "s1"
        ],
        "objective": "Ask Yamada what the village has noticed.",
        "beat": "He talks too fast and lets slip a figure seen on the ridge trail.",
        "reveals": [
          "yamada:0"
        ]
      },
      {
        "id": "s4",
        "kind": "visit",
        "target": "persimmon_drying",
        "requires": [
          "s2"
        ],
        "objective": "Pass the drying racks and take the trail behind the barn.",
        "beat": "Persimmons sway on the racks in the mist while two deer watch you from the terrace edge."
      },
      {
        "id": "s5",
        "kind": "choose",
        "target": "mrs_sato",
        "requires": [
          "s3",
          "s4"
        ],
        "objective": "Meet Mrs. Sato on the stone stairs and decide whom to trust.",
        "beat": "She blocks the steps and asks whether you carry the priest's words or your own.",
        "choices": [
          {
            "label": "Tell her what Yamada saw",
            "unlocks": [
              "s6a"
            ]
          },
          {
            "label": "Keep it to yourself and climb",
            "unlocks": [
              "s6b"
            ]
          }
        ],
        "reveals": [
          "mrs_sato:0"
        ]
      },
      {
        "id": "s6a",
        "kind": "deliver",
        "target": "priest",
        "requires": [
          "s5"
        ],
        "objective": "Return the letter unopened and confront the priest with what you know.",
        "beat": "He admits the rope was cut by his own hand and the letter was meant to call the ridge shrine's keeper down.",
        "item": "sealed_letter",
        "reveals": [
          "priest:0"
        ]
      },
      {
        "id": "s6b",
        "kind": "visit",
        "target": "rice_barn",
        "requires": [
          "s5"
        ],
        "objective": "Climb past the Old Rice Barn toward the ridge with the letter.",
        "beat": "At the top the trail ends at a bell-less frame and a man's lantern long burned out."
      }
    ],
    "endings": [
      {
        "stepId": "s6a",
        "label": "The truth is spoken and the bell is hung again, though not everyone forgives it.",
        "tone": "good"
      },
      {
        "stepId": "s6b",
        "label": "You reach the ridge alone and learn too late what the letter asked of you.",
        "tone": "bitter"
      }
    ]
  },
