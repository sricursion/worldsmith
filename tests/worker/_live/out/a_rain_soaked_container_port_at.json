    {
      "id": "r2",
      "text": "Nobody without a hi-vis hood crosses the quay lane during lifts.",
      "effect": {
        "type": "custom",
        "summary": "Quay lane is closed to pedestrians while the gantry boom is moving."
      },
      "source": "world"
    }
  ],
