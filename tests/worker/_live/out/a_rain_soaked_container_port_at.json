    {
      "id": "tomas",
      "name": "Tomas Reyes",
      "role": "lashing foreman",
      "persona": "A heavy-handed foreman who counts every twist-lock and every favour owed. Talks fast and changes the subject faster when cornered.",
      "knowledge": [
        "Every box on Row C is lashed to the manifest, and the manifest says the stopped reefer holds frozen fish.",
        "The reefer's seal number was cut and replaced; the new seal is cheaper stock than the port issues.",
        "Reefers fail loud, with alarms; this one went quiet, which means someone unplugged it on purpose."
      ],
      "secrets": [
        "He took cash to leave that one box unchecked and now fears what is in it."
      ],
