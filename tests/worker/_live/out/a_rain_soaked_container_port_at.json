  "quest": {
    "id": "silent_reefer",
    "title": "The Reefer That Stopped Humming",
    "hook": "In the rain at Harbour Gate Nine, one reefer on Stack Row C has gone quiet. Its papers say fish, its seal says someone cut it, and its temperature log shows cold where no cold should be. Somebody here knows why, and the tide of trucks is coming.",
    "giver": "mara",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "mara",
        "requires": [],
        "objective": "Hear Mara out about the silent box.",
        "beat": "Mara points down from the gantry to Row C, rain streaming off her hood, and says the humming stopped before dawn."
      },
      {
        "id": "s2",
        "kind": "visit",
        "target": "container_stack",
        "requires": [
          "s1"
        ],
        "objective": "Walk Stack Row C to the dead reefer.",
        "beat": "The row is quiet except for the rain on steel, and a hot-water hiss from the box beside it. The silent reefer's seal hangs wrong."
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "seal_tag",
        "requires": [
          "s2"
        ],
        "objective": "Pick up the cut seal tag.",
        "beat": "The tag number is not on any port issue sheet, and the bolt-cut is fresh.",
        "item": "seal_tag"
      },
      {
        "id": "s4",
        "kind": "talk",
        "target": "tomas",
        "requires": [
          "s3"
        ],
        "objective": "Put the seal to Tomas.",
        "beat": "Tomas stares at the tag, then at the water, and starts talking about lashing.",
        "reveals": [
          "tomas:0"
        ]
      },
      {
        "id": "s5",
        "kind": "choose",
        "target": "lin",
        "requires": [
          "s4"
        ],
        "objective": "Decide what to do with what Tomas admitted.",
        "beat": "Lin waits in the Gate Hut with the night slot records and a phone that has not rung since three.",
        "choices": [
          {
            "label": "Hand the seal and Tomas's confession to Lin.",
            "unlocks": [
              "s6a"
            ]
          },
          {
            "label": "Keep it quiet and open the box yourself.",
            "unlocks": [
              "s6b"
            ]
          }
        ],
        "reveals": [
          "lin:0"
        ]
      },
      {
        "id": "s6a",
        "kind": "confront",
        "target": "lin",
        "requires": [
          "s5"
        ],
        "objective": "Have Lin call it in and put the box on hold.",
        "beat": "Lin files the report, the quay locks down, and the box is opened under escort with Tomas named."
      },
      {
        "id": "s6b",
        "kind": "visit",
        "target": "reefer_bank",
        "requires": [
          "s5"
        ],
        "objective": "Go to the Reefer Bank and read the temperature log.",
        "beat": "The log's cold spot sits in the box's corner, exactly where something is stacked against the wall."
      }
    ],
    "endings": [
      {
        "stepId": "s6a",
        "label": "The box is held, the chain is exposed, and Tomas takes the fall alone.",
        "tone": "good"
      },
      {
        "stepId": "s6b",
        "label": "You open it yourself and find what was never on the manifest, and nobody knows you know.",
        "tone": "bitter"
      }
    ]
  },
  "rules": [
    {
      "id": "r1",
      "text": "No open flame near the Fuel Shed or the reefer row.",
      "effect": {
        "type": "ban",
        "what": "open flame",
        "where": "fuel_shed",
        "enforcer": "tomas"
      },
      "source": "world"
