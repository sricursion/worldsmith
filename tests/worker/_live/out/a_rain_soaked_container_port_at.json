  "quest": {
    "id": "unlogged_box",
    "title": "The Unlogged Box",
    "hook": "The storm is still hammering Quayside Dawn Harbor when Harbormaster Quill finds you at the quay. One sealed container never made it into the log, and the inspector arrives at seven. He needs someone with no ties to the docks to find it and ask no loud questions.",
    "giver": "tobi",
    "steps": [
      {
        "id": "s1_brief",
        "kind": "talk",
        "target": "tobi",
        "requires": [],
        "objective": "Hear Harbormaster Quill's request in Port Control.",
        "beat": "Tobi asks you to find the missing box quietly before the inspector arrives."
      },
      {
        "id": "s2_tag",
        "kind": "fetch",
        "target": "tally_tag",
        "requires": [
          "s1_brief"
        ],
        "objective": "Get the brass tally tag from Halle at The Hook.",
        "beat": "Halle trades the tag for a little gossip and a warning about Dez.",
        "item": "tally_tag",
        "reveals": [
          "halle:0"
        ]
      },
      {
        "id": "s3_search",
        "kind": "visit",
        "target": "container_stack",
        "requires": [
          "s2_tag"
        ],
        "objective": "Search the rusted rows of Stacked Boxes for the matching number.",
        "beat": "Row nine hides a humming reefer with a fresh seal and a matching tag number."
      },
      {
        "id": "s4_dez",
        "kind": "confront",
        "target": "dez",
        "requires": [
          "s3_search"
        ],
        "objective": "Confront Dez about the reefer in his stack.",
        "beat": "Dez admits he hid it on Tobi's orders and begs you to keep his crew out of it.",
        "reveals": [
          "dez:0"
        ]
      },
      {
        "id": "s5_choose",
        "kind": "choose",
        "target": "tobi",
        "requires": [
          "s4_dez"
        ],
        "objective": "Decide what to tell Harbormaster Quill.",
        "beat": "You hold the truth about the box, Dez, and Tobi's own hand in it.",
        "choices": [
          {
            "label": "Expose Tobi's contraband to the inspector",
            "unlocks": [
              "s6_expose"
            ]
          },
          {
            "label": "Quietly return the box to the manifest",
            "unlocks": [
              "s6_cover"
            ]
          }
        ],
        "reveals": [
          "tobi:0"
        ]
      },
      {
        "id": "s6_expose",
        "kind": "deliver",
        "target": "dock_office",
        "requires": [
          "s5_choose"
        ],
        "objective": "Deliver the tally tag to the Harbor Authority as proof.",
        "beat": "The inspector seizes the reefer, Tobi is relieved, and Dez keeps his post.",
        "item": "tally_tag"
      },
      {
        "id": "s6_cover",
        "kind": "talk",
        "target": "tobi",
        "requires": [
          "s5_choose"
        ],
        "objective": "Tell Tobi the box is logged and the inspection is safe.",
        "beat": "Tobi pays you and thanks you, but the contraband sails on and Dez stays complicit."
      }
    ],
    "endings": [
      {
        "stepId": "s6_expose",
        "label": "The port is cleaned, at a cost to its harbormaster.",
        "tone": "good"
      },
      {
        "stepId": "s6_cover",
        "label": "The box slips through and the secret festers.",
        "tone": "bitter"
      }
    ]
  },
