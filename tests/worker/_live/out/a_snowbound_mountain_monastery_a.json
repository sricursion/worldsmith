  "quest": {
    "id": "quiet_bell",
    "title": "The Quiet Bell of Frostbell",
    "hook": "The great bell has hung silent since the monks vanished, and the snow is closing the Pass. Sister Ama, the last keeper, begs you to find out why before the last road is gone.",
    "giver": "sister_ama",
    "steps": [
      {
        "id": "s1_hear",
        "kind": "talk",
        "target": "sister_ama",
        "requires": [],
        "objective": "Hear Sister Ama's plea at the Bell Tower.",
        "beat": "Ama says the rope was cut and begs you to look in the Cold Cellar."
      },
      {
        "id": "s2_lamp",
        "kind": "fetch",
        "target": "tallow_lamp",
        "requires": [
          "s1_hear"
        ],
        "objective": "Take the Tallowlight Lamp from the Refectory Kitchen.",
        "beat": "The lamp flares blue, as if something cold is near.",
        "item": "tallow_lamp"
      },
      {
        "id": "s3_cellar",
        "kind": "visit",
        "target": "cold_cellar",
        "requires": [
          "s2_lamp"
        ],
        "objective": "Visit the Cold Cellar with the lamp.",
        "beat": "Frostmarks glitter on the lower door and the lamp burns blue."
      },
      {
        "id": "s4_tor",
        "kind": "confront",
        "target": "brother_tor",
        "requires": [
          "s3_cellar"
        ],
        "objective": "Confront Brother Tor about the sealed door.",
        "beat": "Tor admits he locked the monks below and gives up the key.",
        "reveals": [
          "brother_tor:0"
        ]
      },
      {
        "id": "s5_choose",
        "kind": "choose",
        "target": "abbot_vane",
        "requires": [
          "s4_tor"
        ],
        "objective": "Face Abbot Vane and decide the bell's fate.",
        "beat": "The Abbot begs you to leave the bell silent, but the monks sleep under his ward.",
        "choices": [
          {
            "label": "Break the silence and ring the bell",
            "unlocks": [
              "s6_ring"
            ]
          },
          {
            "label": "Keep the vigil and let the bell sleep",
            "unlocks": [
              "s6_keep"
            ]
          }
        ],
        "reveals": [
          "abbot_vane:0"
        ]
      },
      {
        "id": "s6_ring",
        "kind": "talk",
        "target": "sister_ama",
        "requires": [
          "s5_choose"
        ],
        "objective": "Tell Sister Ama to ring the Quiet Bell.",
        "beat": "The bell tolls, the monks wake, and the Frostmark cracks as the Pass groans open."
      },
      {
        "id": "s6_keep",
        "kind": "talk",
        "target": "old_hesh",
        "requires": [
          "s5_choose"
        ],
        "objective": "Tell Old Hesh to hold the gate shut.",
        "beat": "The gate stays frozen, the monks sleep on, and you leave the mountain in silence."
      }
    ],
    "endings": [
      {
        "stepId": "s6_ring",
        "label": "The bell rings and the monks wake, though the Abbot never forgives you.",
        "tone": "good"
      },
      {
        "stepId": "s6_keep",
        "label": "The monks sleep forever and the bell stays quiet, a peace bought with a cold grave.",
        "tone": "bitter"
      }
    ]
  },
