  "quest": {
    "id": "lights_back_on",
    "title": "Lights Out on the Strip",
    "hook": "A rival promoter bought the Marina Pier and killed its lights. The bay is going quiet, the crowds are drifting, and summer ends soon. Somebody has to get the neon burning again before the town empties.",
    "giver": "tanya",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "tanya",
        "requires": [],
        "objective": "Hear Tanya out at the Surf Shop.",
        "beat": "Tanya says the pier's power is locked behind a crate at the far end and she knows who has spares."
      },
      {
        "id": "s2",
        "kind": "talk",
        "target": "marco",
        "requires": [
          "s1"
        ],
        "objective": "Ask Marco what the promoter's crew has been saying.",
        "beat": "Marco mentions the padlocked fuse crate and that Vic kept the spares.",
        "reveals": [
          "marco:0"
        ]
      },
      {
        "id": "s3",
        "kind": "visit",
        "target": "marina_pier",
        "requires": [
          "s2"
        ],
        "objective": "Walk out to the Marina Pier past the pelicans.",
        "beat": "The pelicans shift on the roof as you pass. The far-end crate is chained shut and the pier is dark."
      },
      {
        "id": "s4",
        "kind": "fetch",
        "target": "spare_fuses",
        "requires": [
          "s3"
        ],
        "objective": "Get the spare fuses from Vic's bait locker.",
        "beat": "Vic hands over the tin without meeting your eye.",
        "item": "spare_fuses",
        "reveals": [
          "vic:0"
        ]
      },
      {
        "id": "s5",
        "kind": "choose",
        "target": "vic",
        "requires": [
          "s4"
        ],
        "objective": "Decide how to open the fuse crate.",
        "beat": "The chain is thick. You can cut it openly or use the shop key Tanya sold the promoter's man.",
        "choices": [
          {
            "label": "Cut the chain in daylight",
            "unlocks": [
              "s6a"
            ]
          },
          {
            "label": "Use the copied key quietly",
            "unlocks": [
              "s6b"
            ]
          }
        ]
      },
      {
        "id": "s6a",
        "kind": "deliver",
        "target": "vic",
        "requires": [
          "s5"
        ],
        "objective": "Cut the chain and have Vic fit the fuses.",
        "beat": "Vic fits the fuses with shaking hands. The pier lights flare pink and the crowd on the sand cheers.",
        "item": "spare_fuses"
      },
      {
        "id": "s6b",
        "kind": "confront",
        "target": "marco",
        "requires": [
          "s5"
        ],
        "objective": "Face Marco about who really bought the pier.",
        "beat": "Marco admits he was paid to stay quiet. The lights come on quietly, and the promoter will know who did it.",
        "reveals": [
          "marco:0"
        ]
      }
    ],
    "endings": [
      {
        "stepId": "s6a",
        "label": "The Strip Glows Again",
        "tone": "good"
      },
      {
        "stepId": "s6b",
        "label": "Lights On, Bridges Burned",
        "tone": "bitter"
      }
    ]
  },
