  "quest": {
    "id": "silent_relay",
    "title": "Whiteout at Station Nine",
    "hook": "The relay beacon on the ridge went dead in the storm, and Station Nine cannot raise its field team. The crew is shouting at each other over a failing radio while the snow thickens. A stranger with a working set could settle whether anyone is still alive out there, if the stranger will walk into the whiteout.",
    "giver": "ines",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "ines",
        "requires": [],
        "objective": "Ask Ines Doyle what the radio has picked up.",
        "beat": "Ines keeps calling the field team over the hiss, one hand on the dial, and tells you the station set cannot reach the ridge.",
        "reveals": [
          "ines:0"
        ]
      },
      {
        "id": "s2",
        "kind": "fetch",
        "target": "relay_cell",
        "requires": [
          "s1"
        ],
        "objective": "Take a fresh relay cell from the cold store in the Dome.",
        "beat": "The Dome hums in the dark, frost on every panel. Tomas's gear is stacked by the door, the spare cell on top.",
        "item": "relay_cell"
      },
      {
        "id": "s3",
        "kind": "talk",
        "target": "tomas",
        "requires": [
          "s2"
        ],
        "objective": "Ask Tomas Varga how to find the ridge in a whiteout.",
        "beat": "Tomas tells you to follow the staked flags and keep the glacier wall on your right, then goes quiet about why he stayed behind.",
        "reveals": [
          "tomas:0"
        ]
      },
      {
        "id": "s4",
        "kind": "visit",
        "target": "radio_mast",
        "requires": [
          "s3"
        ],
        "objective": "Climb to the Mast and get Oskar's word on the dead relay.",
        "beat": "Wind screams through the lattice. Oskar hauls on the cable and admits the relay was never fully checked before the storm hit.",
        "reveals": [
          "oskar:0"
        ]
      },
      {
        "id": "s5",
        "kind": "choose",
        "target": "mara",
        "requires": [
          "s4"
        ],
        "objective": "Decide whom to trust with the ridge search.",
        "beat": "Mara wants the whole crew held at the station; Ines wants you out on the ridge now. A fox watches the ice from the edge of the lamplight.",
        "choices": [
          {
            "label": "Go up the ridge alone and test the relay",
            "unlocks": [
              "s6a"
            ]
          },
          {
            "label": "Wait for Mara's team to move as a group",
            "unlocks": [
              "s6b"
            ]
          }
        ],
        "reveals": [
          "mara:0"
        ]
      },
      {
        "id": "s6a",
        "kind": "fetch",
        "target": "handheld_set",
        "requires": [
          "s5"
        ],
        "objective": "Get the handheld set from Ines, then climb to the relay.",
        "beat": "Ines unlocks her desk and presses the handheld into your glove. You step out into the white with only the flags to follow.",
        "item": "handheld_set"
      },
      {
        "id": "s6b",
        "kind": "deliver",
        "target": "mara",
        "requires": [
          "s5"
        ],
        "objective": "Hand the relay cell to Mara and let her run the search.",
        "beat": "Mara checks the cell twice, then sends a slow team up the rope line. By the time they reach the ridge the beacon has been dark for hours.",
        "item": "relay_cell"
      }
    ],
    "endings": [
      {
        "stepId": "s6a",
        "label": "You raise the field team through the static: two alive, one lost to the cold.",
        "tone": "bitter"
      },
      {
        "stepId": "s6b",
        "label": "The relay comes back by dawn and the whole field team is found sheltering in the hut.",
        "tone": "good"
      }
    ]
  },
  "rules": [
    {
      "id": "r1",
      "text": "No one crosses the ice alone after dark; the whiteout swallows trails.",
      "effect": {
        "type": "curfew",
        "fromHour": 19,
        "toHour": 6,
        "exemptRoles": [
          "radio operator",
          "field tech"
        ]
