  "quest": {
    "id": "silent_beacon",
    "title": "Whiteout at Station Kestrel",
    "hook": "The fuel beacon has gone silent in the storm. Without it the supply plane cannot find Kestrel before the cache runs dry. Someone at this station knows why the signal died, and nobody is saying. You have a hood, a pack and a day of visibility that is getting shorter.",
    "giver": "mara",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "mara",
        "requires": [],
        "objective": "Hear Mara's account of the dead beacon.",
        "beat": "Mara says the beacon cut out at night and the plane window is closing. She wants it fixed without a fuss."
      },
      {
        "id": "s2",
        "kind": "talk",
        "target": "ines",
        "requires": [
          "s1"
        ],
        "objective": "Ask Ines about the last ping.",
        "beat": "Ines says the signal was cut clean, not lost to weather. She hands you a way to find the pole.",
        "reveals": [
          "ines:0"
        ]
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "locator",
        "requires": [
          "s2"
        ],
        "objective": "Take the handheld locator from the comms mast.",
        "beat": "The locator is cold and the screen flickers in the rime, but it holds a faint bearing.",
        "item": "locator"
      },
      {
        "id": "s4",
        "kind": "visit",
        "target": "fuel_store",
        "requires": [
          "s3"
        ],
        "objective": "Go to the Fuel Cache and press Sven on the generator feed.",
        "beat": "Sven stands among the drums. An arctic fox slips between the sledges, stalking scraps in the tarp's lee.",
        "reveals": [
          "sven:0"
        ]
      },
      {
        "id": "s5",
        "kind": "fetch",
        "target": "beacon_battery",
        "requires": [
          "s4"
        ],
        "objective": "Take the spare beacon battery from Sven's store.",
        "beat": "Sven hands it over grudgingly and says the relay board is somewhere in Module Alpha.",
        "item": "beacon_battery"
      },
      {
        "id": "s6",
        "kind": "choose",
        "target": "mara",
        "requires": [
          "s5"
        ],
        "objective": "Decide how to restore the beacon.",
        "beat": "Teo admits he tapped the feed to save the freezers. Restoring the beacon costs the ice-core samples or the flight.",
        "choices": [
          {
            "label": "Cut power to the freezers and restore the beacon",
            "unlocks": [
              "s7a"
            ]
          },
          {
            "label": "Rig a battery beacon and keep the freezers running",
            "unlocks": [
              "s7b"
            ]
          }
        ],
        "reveals": [
          "teo:0",
          "mara:0"
        ]
      },
      {
        "id": "s7a",
        "kind": "deliver",
        "target": "ines",
        "requires": [
          "s6"
        ],
        "objective": "Bring the battery to Ines to relight the beacon at full power.",
        "beat": "The beacon sings back to life, strong and steady. Down in the dome, the freezers go dark.",
        "item": "beacon_battery"
      },
      {
        "id": "s7b",
        "kind": "deliver",
        "target": "ines",
        "requires": [
          "s6"
        ],
        "objective": "Bring the battery to Ines to run a weak beacon beside the freezers.",
        "beat": "The beacon pulses thin and unsteady through the blizzard. The cores stay frozen, the flight a gamble.",
        "item": "beacon_battery"
      }
    ],
    "endings": [
      {
        "stepId": "s7a",
        "label": "The plane finds Kestrel; the cores thaw and a season's work is lost.",
        "tone": "bitter"
      },
      {
        "stepId": "s7b",
        "label": "A weak signal and a lucky pilot bring the plane in, cores intact.",
        "tone": "good"
      }
    ]
  },
  "rules": [
    {
      "id": "r1",
      "text": "Nobody goes beyond the marker flags alone once the whiteout closes in.",
      "effect": {
        "type": "custom",
        "summary": "Leaving the flagged paths in the blizzard is forbidden without a partner."
