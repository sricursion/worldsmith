  "quest": {
    "id": "relight_the_lantern",
    "title": "The Dimming Lantern",
    "hook": "The Lantern Tower burns low, and the reef folk count the hours until the tide takes the terraces. Pell needs someone who can climb coral and carry light back to the crown. You are a stranger with no stake and steady hands.",
    "giver": "pell",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "pell",
        "requires": [],
        "objective": "Speak with Pell at the Lantern Tower.",
        "beat": "Pell explains the dimming and asks you to find what the Lantern needs."
      },
      {
        "id": "s2",
        "kind": "talk",
        "target": "oru",
        "requires": [
          "s1"
        ],
        "objective": "Ask Oru about the chimes in Bell Grotto.",
        "beat": "Oru says the fault lies in the spire's crown and gives you a way up.",
        "reveals": [
          "oru:0"
        ]
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "kelp_line",
        "requires": [
          "s2"
        ],
        "objective": "Take the kelp climbing line from Bell Grotto.",
        "beat": "The line is stiff with salt but sound. Jellies drift past the entrance.",
        "item": "kelp_line"
      },
      {
        "id": "s4",
        "kind": "fetch",
        "target": "crown_pearl",
        "requires": [
          "s3"
        ],
        "objective": "Get a crown pearl from the Kelp Market.",
        "beat": "Mira's stall holds the pearl. She names her price and hints where it came from.",
        "item": "crown_pearl",
        "reveals": [
          "mira:0"
        ]
      },
      {
        "id": "s5",
        "kind": "visit",
        "target": "coral_spire",
        "requires": [
          "s4"
        ],
        "objective": "Climb the Spire of the Tide-Mother with the line.",
        "beat": "You haul up the coral with a light in the dark water and clear the blocked vent."
      },
      {
        "id": "s6",
        "kind": "choose",
        "target": "pell",
        "requires": [
          "s5"
        ],
        "objective": "Decide what to do with the crown pearl.",
        "beat": "The vent runs clear, but the pearl can seat the wick or go back to Mira.",
        "choices": [
          {
            "label": "Set the pearl in the Lantern's crown",
            "unlocks": [
              "s7a"
            ]
          },
          {
            "label": "Return the pearl to Mira and expose the sale",
            "unlocks": [
              "s7b"
            ]
          }
        ]
      },
      {
        "id": "s7a",
        "kind": "deliver",
        "target": "pell",
        "requires": [
          "s6"
        ],
        "objective": "Bring the pearl to Pell for the Lantern.",
        "beat": "Pell seats the pearl and the Lantern blazes teal across the reef.",
        "item": "crown_pearl"
      },
      {
        "id": "s7b",
        "kind": "confront",
        "target": "pell",
        "requires": [
          "s6"
        ],
        "objective": "Confront Pell about the pearls she sold.",
        "beat": "Pell admits the sale. The Lantern burns, but the wardens are shamed.",
        "reveals": [
          "pell:0"
        ]
      }
    ],
    "endings": [
      {
        "stepId": "s7a",
        "label": "The Lantern is relit and the reef is safe.",
        "tone": "good"
      },
      {
        "stepId": "s7b",
        "label": "The light returns but trust in the wardens does not.",
        "tone": "bitter"
      }
    ]
  },
