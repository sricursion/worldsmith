  "quest": {
    "id": "dark_mast",
    "title": "The Dark Mast",
    "hook": "The Broadcast Mast went dark at 21:40 and the blackout is creeping down through the lower city, block by block. The sirens are silent and nobody downstairs knows why. Up here on the roofs, someone does, and the trail points north to Hartwell Tower.",
    "giver": "mara",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "mara",
        "requires": [],
        "objective": "Hear Mara's account of the blackout.",
        "beat": "Mara points north through the rain. The mast was cut, she says, not broken."
      },
      {
        "id": "s2",
        "kind": "visit",
        "target": "signal_mast",
        "requires": [
          "s1"
        ],
        "objective": "Climb the Broadcast Mast and look for signs of sabotage.",
        "beat": "Rain streaks the lattice. Fresh tool marks gleam at the base."
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "gray_jersey",
        "requires": [
          "s2"
        ],
        "objective": "Take the torn gray jersey scrap from the lattice.",
        "beat": "A strip of gray cloth, snagged high up, flutters in the wind.",
        "item": "gray_jersey"
      },
      {
        "id": "s4",
        "kind": "talk",
        "target": "dex",
        "requires": [
          "s3"
        ],
        "objective": "Ask Dex what he saw from the roof.",
        "beat": "Dex mutters to his pigeons, then admits he saw someone climb the mast.",
        "reveals": [
          "dex:0"
        ]
      },
      {
        "id": "s5",
        "kind": "choose",
        "target": "luca",
        "requires": [
          "s4"
        ],
        "objective": "Decide how to deal with Luca at the Meridian.",
        "beat": "Luca blocks the bank door, sweating. The north door key bulges in his pocket.",
        "choices": [
          {
            "label": "Press Luca until he talks",
            "unlocks": [
              "s6a"
            ]
          },
          {
            "label": "Bargain quietly with Dex's cut cable",
            "unlocks": [
              "s6b"
            ]
          }
        ]
      },
      {
        "id": "s6a",
        "kind": "confront",
        "target": "luca",
        "requires": [
          "s5"
        ],
        "objective": "Confront Luca about the bribe.",
        "beat": "Luca cracks and hands over the north key, begging you to keep his name out of it.",
        "reveals": [
          "luca:0"
        ]
      },
      {
        "id": "s6b",
        "kind": "talk",
        "target": "mara",
        "requires": [
          "s5"
        ],
        "objective": "Bring Mara the truth about her sold codes.",
        "beat": "Mara goes quiet, then admits she sold the codes. She gives you the way up the north stair.",
        "reveals": [
          "mara:0"
        ]
      }
    ],
    "endings": [
      {
        "stepId": "s6a",
        "label": "Luca's key opens the north door and the lights return, at a cost to his job.",
        "tone": "bitter"
      },
      {
        "stepId": "s6b",
        "label": "Mara owns her mistake and restores the mast with Dex's cable.",
        "tone": "good"
      }
    ]
  },
