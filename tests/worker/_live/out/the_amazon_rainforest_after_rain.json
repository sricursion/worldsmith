  "quest": {
    "id": "lost_net",
    "title": "Canopy After the Rain",
    "hook": "The rain has swollen the river and swallowed the fishing trails. Tupa's net, her mother's, is somewhere on the flooded bank, and she cannot cross while the water is rising and the jaguar is walking the high ground. She will pay in fish and directions to anyone who brings it back.",
    "giver": "tupa",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "tupa",
        "requires": [],
        "objective": "Hear Tupa out at the stilt hut about the lost net.",
        "beat": "Rain drums on the palm thatch as Tupa points at the washed-out trail and says the net is gone.",
        "reveals": [
          "tupa:0"
        ]
      },
      {
        "id": "s2",
        "kind": "visit",
        "target": "kapok_trunk",
        "requires": [
          "s1"
        ],
        "objective": "Go to the Fallen Giant and look over the flooded bank from its length.",
        "beat": "The hollow kapok trunk lies 40 m long in the mist; howlers shout from the canopy and macaws wheel over the river."
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "fishnet",
        "requires": [
          "s2"
        ],
        "objective": "Cross the flooded bank and pull the net free from the root where it is tied.",
        "beat": "The water is brown and fast, and piranha flash near the drop. The net is knotted to a root, silt-heavy but whole. Somewhere uphill the jaguar is stalking.",
        "item": "fishnet"
      },
      {
        "id": "s4",
        "kind": "deliver",
        "target": "tupa",
        "requires": [
          "s3"
        ],
        "objective": "Bring the net back to Tupa.",
        "beat": "Tupa runs her hands over the knots, checks every float, and says nothing for a while.",
        "item": "fishnet"
      }
    ],
    "endings": [
      {
        "stepId": "s4",
        "label": "The net comes home, and Tupa fishes again when the water drops.",
        "tone": "good"
      }
    ]
  },
  "rules": [
    {
      "id": "r1",
      "text": "Nobody wades the flooded bank after dusk; the jaguar hunts the high ground and the piranha feed in the shallows.",
      "effect": {
        "type": "custom",
        "summary": "Crossing the flooded bank after dusk is avoided by locals."
      },
      "source": "world"
    },
    {
      "id": "r2",
