  "quest": {
    "id": "far_bank",
    "title": "The Trail the River Took",
    "hook": "The igarapé swallowed the varadouro overnight, three metres of brown water over Tonho's whole rubber trail. He stands on his stilt hut's ladder watching the current, and he needs someone who reads the forest to get him and his season's work to the far bank before the water finishes the job.",
    "giver": "tonho",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "tonho",
        "requires": [],
        "objective": "Hear Tonho out at the stilt hut.",
        "beat": "Tonho points to where the trail ran and now only treetops show. He says the cups must cross before dark."
      },
      {
        "id": "s2",
        "kind": "visit",
        "target": "kapok_trunk",
        "requires": [
          "s1"
        ],
        "objective": "Go to the Fallen Giant and check the high ground.",
        "beat": "The macaws wheel overhead, shrieking at something on the bank. The hollow trunk is dry and the jaguar's tracks cross the mud outside.",
        "reveals": [
          "tonho:0"
        ]
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "latex_cups",
        "requires": [
          "s2"
        ],
        "objective": "Take the latex cups from the trunk.",
        "beat": "The cups are heavy and sticky. The howlers bark in the canopy while you work, loud and nervous.",
        "item": "latex_cups"
      },
      {
        "id": "s4",
        "kind": "deliver",
        "target": "tonho",
        "requires": [
          "s3"
        ],
        "objective": "Bring the cups back to Tonho.",
        "beat": "Tonho counts them twice, mutters a sum in reais, then nods toward the water. Together you pick the shallow line through the flooded trees.",
        "item": "latex_cups"
      },
      {
        "id": "s5",
        "kind": "talk",
        "target": "tonho",
        "requires": [
          "s4"
        ],
        "objective": "Cross with Tonho and speak to him on the far bank.",
        "beat": "He sets the cups on dry ground and says nothing for a while. The river keeps rising behind you."
      }
    ],
    "endings": [
      {
        "stepId": "s5",
        "label": "The season's rubber reaches the far bank. The trail is gone, but Tonho is not.",
        "tone": "good"
      }
