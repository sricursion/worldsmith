  "quest": {
    "id": "first_light",
    "title": "First Light on Mars",
    "hook": "The first sealed crop on Mars died overnight. Mara swears the dome seal failed, and if it did, every dome is next and the colony starves by spring. Find out what broke before the O2 rations run out.",
    "giver": "mara",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "mara",
        "requires": [],
        "objective": "Hear Mara's account at the Growth Lab.",
        "beat": "Mara shows you the grey trays. She suspects the door seal and wants proof."
      },
      {
        "id": "s2",
        "kind": "fetch",
        "target": "pressure_log",
        "requires": [
          "s1"
        ],
        "objective": "Get the overnight pressure log from Ops Mast.",
        "beat": "Teo hands over the strip. A pressure drop at 0312 is circled in his marker.",
        "item": "pressure_log",
        "reveals": [
          "teodor:0"
        ]
      },
      {
        "id": "s3",
        "kind": "visit",
        "target": "lab_dome",
        "requires": [
          "s2"
        ],
        "objective": "Inspect the dome door seal.",
        "beat": "Dust has scoured the collar gasket to a thin ribbon. It has been leaking for sols.",
        "reveals": [
          "mara:0"
        ]
      },
      {
        "id": "s4",
        "kind": "confront",
        "target": "jun",
        "requires": [
          "s3"
        ],
        "objective": "Ask Jun about the gasket batch.",
        "beat": "Jun admits the batch was marginal and points you to the spare in Hab One's locker.",
        "reveals": [
          "jun:0"
        ]
      },
      {
        "id": "s5",
        "kind": "fetch",
        "target": "spare_gasket",
        "requires": [
          "s4"
        ],
        "objective": "Fetch the spare gasket from Hab One.",
        "beat": "Sana lets you into the pressure locker. One good seal is left.",
        "item": "spare_gasket"
      },
      {
        "id": "s6",
        "kind": "choose",
        "target": "mara",
        "requires": [
          "s5"
        ],
        "objective": "Decide who gets the last gasket.",
        "beat": "There is only one good seal, and two ways to spend it.",
        "choices": [
          {
            "label": "Reseal the lab dome and replant",
            "unlocks": [
              "s7a"
            ]
          },
          {
            "label": "Hold it for Hab One's life support",
            "unlocks": [
              "s7b"
            ]
          }
        ]
      },
      {
        "id": "s7a",
        "kind": "deliver",
        "target": "mara",
        "requires": [
          "s6"
        ],
        "objective": "Deliver the gasket to Mara.",
        "beat": "The dome holds pressure. Mara replants before dawn and the first green shoot lifts by morning.",
        "item": "spare_gasket"
      },
      {
        "id": "s7b",
        "kind": "deliver",
        "target": "sana",
        "requires": [
          "s6"
        ],
        "objective": "Deliver the gasket to Sana.",
        "beat": "Hab One stays sealed and safe, but the lab stays dark and the crop is lost.",
        "item": "spare_gasket"
      }
    ],
    "endings": [
      {
        "stepId": "s7a",
        "label": "The crop returns and the colony has food.",
        "tone": "good"
      },
      {
        "stepId": "s7b",
        "label": "The colony breathes, but the seedlings are gone.",
        "tone": "bitter"
      }
    ]
  },
