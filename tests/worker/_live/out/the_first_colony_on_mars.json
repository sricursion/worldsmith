  "quest": {
    "id": "failing_reactor",
    "title": "Coolant Loop",
    "hook": "Reactor Hall 1 is bleeding coolant faster than the engineers can patch it, and the override that did it was entered by hand. Commander Vance needs the loop stabilised and the hand identified before the supply ship arrives.",
    "giver": "commander_vance",
    "steps": [
      {
        "id": "briefing",
        "kind": "talk",
        "target": "commander_vance",
        "requires": [],
        "objective": "Take the commander’s briefing on Command Deck.",
        "beat": "Vance gives you nine days, a spare injector somewhere in Cold Stores, and a warning that the sabotage was an inside job.",
        "reveals": [
          "commander_vance:0"
        ]
      },
      {
        "id": "inspect_reactor",
        "kind": "visit",
        "target": "hab_one",
        "requires": [
          "briefing"
        ],
        "objective": "Inspect the failing coolant loop in Reactor Hall 1.",
        "beat": "The coolant manifold hisses. The override log shows a hand-entered command at 03:10 under Oku’s badge."
      },
      {
        "id": "get_injector",
        "kind": "fetch",
        "target": "coolant_injector",
        "item": "coolant_injector",
        "requires": [
          "inspect_reactor"
        ],
        "objective": "Take the spare injector from Cold Stores.",
        "beat": "Brannock grunts, nods at the third locker and watches you lift the foam cradle out.",
        "reveals": [
          "brannock_hauler:0"
        ]
      },
      {
        "id": "fit_injector",
        "kind": "deliver",
        "target": "chief_oku",
        "item": "coolant_injector",
        "requires": [
          "get_injector"
        ],
        "objective": "Bring the injector to Chief Oku.",
        "beat": "Oku installs it in suits, swearing the whole time. The loop stabilises and the alarm falls silent for the first time in days.",
        "reveals": [
          "chief_oku:0"
        ]
      },
      {
        "id": "get_log",
        "kind": "fetch",
        "target": "access_log",
        "item": "access_log",
        "requires": [
          "fit_injector"
        ],
        "objective": "Collect the door-access log mirror from Dr. Bright.",
        "beat": "Bright hands over the slate and points to a hangar-corridor entry at 03:07, badge cloned.",
        "reveals": [
          "dr_bright:0"
        ]
      },
      {
        "id": "face_dax",
        "kind": "confront",
        "target": "pilot_dax",
        "requires": [
          "get_log"
        ],
        "objective": "Confront Dax Orlov at the hangar.",
        "beat": "Dax taps the console, then breaks. The Combine paid him to slow the loop, and the override went further than he meant.",
        "reveals": [
          "pilot_dax:0",
          "mika_tanaka:0"
        ]
      },
      {
        "id": "end_report",
        "kind": "deliver",
        "target": "commander_vance",
        "item": "access_log",
        "requires": [
          "face_dax"
        ],
        "objective": "Report to the commander with the access log.",
        "beat": "Vance reads the log, orders Dax into holding, and cancels her evacuation draft. The station survives with its crew intact."
      },
      {
        "id": "end_run",
        "kind": "talk",
        "target": "pilot_dax",
        "requires": [
          "face_dax"
        ],
        "objective": "Offer Dax a chance to fly the supply run first.",
        "beat": "Dax accepts, flies the repair burn, and disappears on the first ship out. The station lives; the Combine learns nothing."
      }
    ],
    "endings": [
      {
        "stepId": "end_report",
        "label": "The saboteur held, the station kept",
        "tone": "good"
      },
      {
        "stepId": "end_run",
        "label": "The reactor holds and the culprit walks free",
        "tone": "bitter"
      }
    ]
