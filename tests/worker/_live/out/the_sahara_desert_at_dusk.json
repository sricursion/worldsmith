  "quest": {
    "id": "last_light_wells",
    "title": "Last Light at the Wells",
    "hook": "The seven wells are giving half what they did, and the cold nights are coming. The caravan must cross the dune sea to the next oasis, and it cannot do it on what is left. Tamast and Idir will take any stranger's help they can get, if the stranger can bear the truth about the water.",
    "giver": "tamast",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "tamast",
        "requires": [],
        "objective": "Speak to Tamast about the failing wells.",
        "beat": "Tamast shows you the wells, one by one. The deepest still seeps, but the sand keeps filling it.",
        "reveals": [
          "tamast:0"
        ]
      },
      {
        "id": "s2",
        "kind": "visit",
        "target": "caravan_camp",
        "requires": [
          "s1"
        ],
        "objective": "Check the seep in the deepest well at the Camp of Seven Wells.",
        "beat": "The low goat-hair tent throws a long shadow over the well. The seep is real, but slow, and the dust is already closing it."
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "water_skins",
        "requires": [
          "s2"
        ],
        "objective": "Gather the water skins from the camp.",
        "beat": "The skins are dry and cracked. Four will not carry a caravan, and Idir will not meet your eye when you count them.",
        "item": "water_skins"
      },
      {
        "id": "s4",
        "kind": "talk",
        "target": "idir",
        "requires": [
          "s3"
        ],
        "objective": "Ask Idir why the skins are so few.",
        "beat": "The camels graze nearby while the hawk circles overhead. Idir admits he traded two skins for dirhams and hands you the pouch.",
        "reveals": [
          "idir:0"
        ]
      },
      {
        "id": "s5",
        "kind": "choose",
        "target": "tamast",
        "requires": [
          "s4"
        ],
        "objective": "Decide what to do about Idir's trade.",
        "beat": "Tamast waits for your answer with the pouch in view. The dune sea is turning gold and then grey.",
        "choices": [
          {
            "label": "Hand the dirhams to Tamast and tell her everything",
            "unlocks": [
              "s6a"
            ]
          },
          {
            "label": "Keep it quiet and trade the dirhams for skins yourself",
            "unlocks": [
              "s6b"
            ]
          }
        ]
      },
      {
        "id": "s6a",
        "kind": "deliver",
        "target": "tamast",
        "requires": [
          "s5"
        ],
        "objective": "Give Tamast the skins and the truth.",
        "beat": "Tamast takes the skins and the coins without a word, then sets Idir to clearing the deepest well at first light.",
        "item": "water_skins"
      },
      {
        "id": "s6b",
        "kind": "deliver",
        "target": "idir",
        "requires": [
          "s5"
        ],
        "objective": "Give Idir the skins and keep the secret.",
        "beat": "Idir takes the skins and nods once. The caravan will leave short of water and long on silence.",
        "item": "water_skins"
      }
    ],
    "endings": [
      {
        "stepId": "s6a",
        "label": "The caravan crosses with the wells cleared and the truth told.",
        "tone": "good"
      },
      {
        "stepId": "s6b",
        "label": "The caravan crosses thirsty, held together by a lie.",
        "tone": "bitter"
      }
    ]
  },
