  "quest": {
    "id": "seven_wells",
    "title": "The Sinking of Seven Wells",
    "hook": "The wells of the camp drop a little more each dusk, and the caravan cannot cross the erg on dry skins. Idir blames the heat; Tinhinan blames herself. Someone who looks where the locals won't might find where the water is going.",
    "giver": "tinhinan",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "tinhinan",
        "requires": [],
        "objective": "Hear Tinhinan's account of the failing wells.",
        "beat": "She shows you the seventh well, nearly dry, and asks you to read the cord yourself."
      },
      {
        "id": "s2",
        "kind": "talk",
        "target": "idir",
        "requires": [
          "s1"
        ],
        "objective": "Ask Idir why the camels shun the third well.",
        "beat": "Idir mutters about the herd and the wrong smell, eyes on the dunes, as the hawk circles overhead.",
        "reveals": [
          "idir:0"
        ]
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "knotted_cord",
        "requires": [
          "s2"
        ],
        "objective": "Take Tinhinan's cord to measure the wells yourself.",
        "beat": "The knots confirm it: the water falls fastest in the wells nearest the east dunes.",
        "item": "knotted_cord"
      },
      {
        "id": "s4",
        "kind": "visit",
        "target": "caravan_camp",
        "requires": [
          "s3"
        ],
        "objective": "Follow the camels as they graze the camp's east edge at dusk.",
        "beat": "The dromedaries nose the sand toward the east and bawl; the hawk wheels over the same spot.",
        "reveals": [
          "tinhinan:0"
        ]
      },
      {
        "id": "s5",
        "kind": "choose",
        "target": "tinhinan",
        "requires": [
          "s4"
        ],
        "objective": "Decide what to tell the camp about the underground thudding and the old pipe.",
        "beat": "The sand east of camp has slumped over a broken pipe leaking the vein away. You can say it plainly or spare the keeper.",
        "choices": [
          {
            "label": "Tell the whole camp the truth and dig out the pipe together",
            "unlocks": [
              "s6a"
            ]
          },
          {
            "label": "Quietly seal the pipe yourself and say nothing",
            "unlocks": [
              "s6b"
            ]
          }
        ]
      },
      {
        "id": "s6a",
        "kind": "talk",
        "target": "idir",
        "requires": [
          "s5"
        ],
        "objective": "Rally Idir and the drovers to dig out the broken pipe.",
        "beat": "Idir confesses the sold skins, and the camp digs through the night. The wells begin to rise."
      },
      {
        "id": "s6b",
        "kind": "talk",
        "target": "tinhinan",
        "requires": [
          "s5"
        ],
        "objective": "Report the sealed pipe to Tinhinan alone.",
        "beat": "The wells hold, but the camp never learns why, and Idir's secret rots unspoken."
      }
    ],
    "endings": [
      {
        "stepId": "s6a",
        "label": "The camp digs together and the wells recover.",
        "tone": "good"
      },
      {
        "stepId": "s6b",
        "label": "The water returns, but trust in the camp stays thin.",
        "tone": "bitter"
      }
    ]
  },
  "rules": [
