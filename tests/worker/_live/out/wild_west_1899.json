  "quest": {
    "id": "dry_creek_payroll",
    "title": "The Dry Creek Payroll",
    "hook": "The territorial payroll vanished from the stagecoach last night, and the Territorial Bank is shaking. Marshal Holloway has no leads and a town ready to hang the first stranger it can find. You ride in at dusk with a steady hand and a day to prove the payroll is still in Dry Creek.",
    "giver": "jack",
    "steps": [
      {
        "id": "s1",
        "kind": "talk",
        "target": "jack",
        "requires": [],
        "objective": "Hear the marshal's account of the missing payroll.",
        "beat": "Jack tells you the strongbox was pried open and the coach came in empty. He wants it found quietly."
      },
      {
        "id": "s2",
        "kind": "talk",
        "target": "mabel",
        "requires": [
          "s1"
        ],
        "objective": "Ask Mabel Pruitt about a stranger buying a crowbar.",
        "beat": "Mabel admits a gray-duster man bought tools, then lets slip he went toward the livery.",
        "reveals": [
          "mabel:0"
        ]
      },
      {
        "id": "s3",
        "kind": "fetch",
        "target": "silver_spur",
        "requires": [
          "s1"
        ],
        "objective": "Pick up the silver spur left on the bar at The Iron Spur.",
        "beat": "The spur is fine work, too fine for a drover. Silas watches you pocket it.",
        "item": "silver_spur"
      },
      {
        "id": "s4",
        "kind": "visit",
        "target": "stable",
        "requires": [
          "s2"
        ],
        "objective": "Climb to the loft at Dunn Livery while the horses stamp below.",
        "beat": "Hitched horses shift in the dusk as you climb. A canvas sack lies behind the hay, stamped Territorial Bank."
      },
      {
        "id": "s5",
        "kind": "fetch",
        "target": "payroll_sack",
        "requires": [
          "s4"
        ],
        "objective": "Take the payroll sack from the loft.",
        "beat": "The sack is heavy and mostly full. Whoever hid it meant to come back.",
        "item": "payroll_sack"
      },
      {
        "id": "s6",
        "kind": "choose",
        "target": "jack",
        "requires": [
          "s3",
          "s5"
        ],
        "objective": "Decide what to do with the payroll and the man behind it.",
        "beat": "You hold the sack and the spur. Jack waits, and the bank watches.",
        "choices": [
          {
            "label": "Hand it all to the marshal",
            "unlocks": [
              "s7a"
            ]
          },
          {
            "label": "Return it to the bank and keep the thief quiet",
            "unlocks": [
              "s7b"
            ]
          }
        ]
      },
      {
        "id": "s7a",
        "kind": "deliver",
        "target": "jack",
        "requires": [
          "s6"
        ],
        "objective": "Deliver the payroll sack to Marshal Holloway.",
        "beat": "Jack counts it twice and locks it in the office. The town sleeps easier, and he starts a proper hunt for the stranger.",
        "item": "payroll_sack"
      },
      {
        "id": "s7b",
        "kind": "deliver",
        "target": "jack",
        "requires": [
          "s6"
        ],
        "objective": "Give Jack the sack and let him settle it with the bank.",
        "beat": "Jack takes it with a hard look. The bank gets its money, but the stranger rides out unpunished.",
        "item": "payroll_sack"
      }
    ],
    "endings": [
      {
        "stepId": "s7a",
        "label": "The payroll is recovered and the law holds.",
        "tone": "good"
      },
      {
        "stepId": "s7b",
        "label": "The money returns, but the thief walks.",
        "tone": "bitter"
      }
    ]
  },
