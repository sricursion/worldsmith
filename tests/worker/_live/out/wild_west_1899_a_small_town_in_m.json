  "quest": {
    "id": "vanished_thirty_thousand",
    "title": "Thirty Thousand Gone",
    "hook": "Thirty thousand dollars vanished from the Territorial Bank last night, and Sheriff Crane trusts no one in Dustfall Gulch. He needs a stranger with clean hands to find the money before the territory auditor rides in.",
    "giver": "marshal",
    "steps": [
      {
        "id": "s1_talk",
        "kind": "talk",
        "target": "marshal",
        "requires": [],
        "objective": "Hear Sheriff Crane's account of the robbery.",
        "beat": "Crane pins the star on you and says the vault was opened with a key."
      },
      {
        "id": "s2_visit",
        "kind": "visit",
        "target": "bank",
        "requires": [
          "s1_talk"
        ],
        "objective": "Inspect the Territorial Bank.",
        "beat": "The vault shows no marks and the ledger pages are torn."
      },
      {
        "id": "s3_fetch",
        "kind": "fetch",
        "target": "ledger",
        "requires": [
          "s2_visit"
        ],
        "objective": "Take the bank ledger.",
        "beat": "The crossed-out sums were short long before last night.",
        "item": "ledger",
        "reveals": [
          "banker:0"
        ]
      },
      {
        "id": "s4_talk",
        "kind": "talk",
        "target": "barkeep",
        "requires": [
          "s3_fetch"
        ],
        "objective": "Press Mabel Rourke about the night.",
        "beat": "Mabel admits she saw the Reverend carry a satchel into the chapel.",
        "reveals": [
          "barkeep:0"
        ]
      },
      {
        "id": "s5_choose",
        "kind": "choose",
        "target": "preacher",
        "requires": [
          "s4_talk"
        ],
        "objective": "Decide how to handle the Reverend and the banker.",
        "beat": "The Reverend admits hiding the satchel and begs you to hear him out.",
        "choices": [
          {
            "label": "Arrest Thorn and clear the Reverend",
            "unlocks": [
              "s6_confront"
            ]
          },
          {
            "label": "Return the money quietly and spare Thorn",
            "unlocks": [
              "s6_deliver"
            ]
          }
        ],
        "reveals": [
          "preacher:0"
        ]
      },
      {
        "id": "s6_confront",
        "kind": "confront",
        "target": "banker",
        "requires": [
          "s5_choose"
        ],
        "objective": "Confront Elias Thorn with the ledger.",
        "beat": "Thorn breaks down and confesses the staged robbery."
      },
      {
        "id": "s6_deliver",
        "kind": "deliver",
        "target": "marshal",
        "requires": [
          "s5_choose"
        ],
        "objective": "Hand the ledger to Sheriff Crane.",
        "beat": "Crane reads it in silence and decides what the town can bear.",
        "item": "ledger"
      }
    ],
    "endings": [
      {
        "stepId": "s6_confront",
        "label": "Thorn goes to the lockup and the miners are paid.",
        "tone": "good"
      },
      {
        "stepId": "s6_deliver",
        "label": "The money returns, the truth stays buried, and the auditor finds nothing.",
        "tone": "bitter"
      }
    ]
  },
