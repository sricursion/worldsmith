 "quest": {
  "id": "cold_mint_spring",
  "title": "The Softening Crown",
  "hook": "The royal sugar crown is sagging in the dusk sun, and when it melts the kingdom loses its king. Pip the baker swears only cold-mint from the old spring can set it, but the spring is dissolving too. A stranger could find it first, if the stranger can sift truth from gossip in a town that sells everything.",
  "giver": "pip",
  "steps": [
   {
    "id": "s1",
    "kind": "talk",
    "target": "pip",
    "requires": [],
    "objective": "Hear Pip's plea about the crown.",
    "beat": "Pip wrings flour from his hands and begs you to find cold-mint before the crown slumps for good."
   },
   {
    "id": "s2",
    "kind": "fetch",
    "target": "frosted_jar",
    "requires": [
     "s1"
    ],
    "objective": "Take the Frosted Jar from the Lollipop Market stall.",
    "beat": "Mabel's jar is cold to the touch, a sign mint grew near its source.",
    "item": "frosted_jar",
    "reveals": [
     "mabel:0"
    ]
   },
   {
    "id": "s3",
    "kind": "visit",
    "target": "toffee_bridge",
    "requires": [
     "s2"
    ],
    "objective": "Follow the geese to Toffee Bridge Square.",
    "beat": "The marshmallow geese flock honking on the square, shedding frosted feathers toward the river."
   },
   {
    "id": "s4",
    "kind": "choose",
    "target": "jory",
    "requires": [
     "s3"
    ],
    "objective": "Decide how to deal with Jory, who knows the spring.",
    "beat": "Jory admits he found the spring and fears Tansy's debt. You can press him or protect him.",
    "choices": [
     {
      "label": "Press Jory to lead you to the spring now",
      "unlocks": [
       "s5a"
      ]
     },
     {
      "label": "Pay Jory's debt to Tansy and earn his trust",
      "unlocks": [
       "s5b"
      ]
     }
    ],
    "reveals": [
     "jory:0",
     "tansy:0"
    ]
   },
   {
    "id": "s5a",
    "kind": "visit",
    "target": "wafer_mill",
    "requires": [
     "s4"
    ],
    "objective": "Reach the mill and the spring beyond it by force of will.",
    "beat": "Jory leads you sullenly upstream past the licorice wheel to a pool rimed in frost. The mint is thin and bitter, but it is there."
   },
   {
    "id": "s5b",
    "kind": "deliver",
    "target": "pip",
    "requires": [
     "s4"
    ],
    "objective": "Bring Pip the Cold-Mint Leaf bought clean from Tansy.",
    "beat": "With the debt settled, Jory and Tansy part the mint freely. Pip sets the crown with trembling hands.",
    "item": "mint_leaf"
   }
  ],
  "endings": [
   {
