 "quest": {
  "id": "drowned_churchyard",
  "title": "What Walks the Moor",
  "hook": "Fresh graves in St Ewan's churchyard keep opening overnight, and the sexton has gone silent. The villagers bar their doors by dusk. Someone with no kin buried here must learn what climbs out and where it goes.",
  "giver": "widow_marne",
  "steps": [
   {
    "id": "s1_talk",
    "kind": "talk",
    "target": "widow_marne",
    "requires": [],
    "objective": "Ask Marne about the opened graves",
    "beat": "Marne says her husband's grave was emptied and the shroud taken. She asks you to find out why Bram will not speak."
   },
   {
    "id": "s2_visit",
    "kind": "visit",
    "target": "lych_gate",
    "requires": [
     "s1_talk"
    ],
    "objective": "Search the lychway for tracks",
    "beat": "Black peat prints cross the lychway toward the mound. Crows watch from the chapel gable, silent, and a bone charm lies in the mud."
   },
   {
    "id": "s3_fetch",
    "kind": "fetch",
    "target": "wight_bone_charm",
    "requires": [
     "s2_visit"
    ],
    "objective": "Take the bone charm from the lych gate",
    "beat": "The charm is a wight's token, left by something that wanted to be found. Grave moths drift thick around the crypt beyond.",
    "item": "wight_bone_charm"
   },
   {
    "id": "s4_talk",
    "kind": "talk",
    "target": "sexton_bram",
    "requires": [
     "s3_fetch"
    ],
    "objective": "Show Bram the charm and make him talk",
    "beat": "Bram goes grey. He admits he opened a grave himself, and the wight has been digging out the rest of the dead since.",
    "reveals": [
     "sexton_bram:0"
    ]
   },
   {
    "id": "s5_visit",
    "kind": "visit",
    "target": "crypt",
    "requires": [
     "s4_talk"
    ],
    "objective": "Go to the half-sunk crypt door",
    "beat": "The vault door stands ajar, peat smeared on the stone. Something inside is breathing, and moths pour from the dark.",
    "reveals": [
     "widow_marne:0"
    ]
   },
   {
    "id": "s6_choose",
    "kind": "choose",
    "target": "sexton_bram",
    "requires": [
     "s5_visit"
    ],
    "objective": "Decide the wight's fate",
    "beat": "The wight is Bram's brother, drowned in the peat and dragged back by the shroud. Bram waits for your word.",
    "choices": [
     {
      "label": "Bind the wight with the bone charm and reseal the crypt",
      "unlocks": [
       "s7_bind"
      ]
     },
     {
      "label": "Open the vault and let it walk the moor",
      "unlocks": [
       "s7_free"
      ]
     }
    ]
   },
   {
    "id": "s7_bind",
    "kind": "confront",
    "target": "sexton_bram",
    "requires": [
     "s6_choose"
    ],
    "objective": "Reseal the crypt with Bram",
    "beat": "Bram sets the charm in the door and the knocking stops. The graves stay shut, and Marne's husband stays gone."
   },
   {
    "id": "s7_free",
    "kind": "confront",
    "target": "widow_marne",
    "requires": [
     "s6_choose"
    ],
    "objective": "Open the vault for the wight",
    "beat": "The wight walks into the fog toward the moor. Marne watches it go and the graves lie quiet, though the hound still howls."
   }
  ],
  "endings": [
   {
    "stepId": "s7_bind",
    "label": "The wight is sealed and the churchyard sleeps",
    "tone": "good"
   },
   {
    "stepId": "s7_free",
    "label": "The wight walks free and the moor keeps it",
    "tone": "bitter"
   }
  ]
 },
