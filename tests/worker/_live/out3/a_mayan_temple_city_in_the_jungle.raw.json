 "quest": {
  "id": "quiet_stair",
  "title": "The Quiet Stair",
  "hook": "Mist sits on the Temple of the Jaguar Sun and the glyph stair no longer speaks. The dawn ritual has not been sung in a season, and the caretakers say roots have buried what must be read. They will take help from a stranger with steady hands.",
  "giver": "itzel",
  "steps": [
   {
    "id": "s1_talk",
    "kind": "talk",
    "target": "itzel",
    "requires": [],
    "objective": "Hear Itzel out at the Plaza of Stelae.",
    "beat": "Itzel says the stair fell quiet after the rains and sends you to Balam, who knows the stone."
   },
   {
    "id": "s2_adze",
    "kind": "fetch",
    "target": "cleaning_adze",
    "requires": [
     "s1_talk"
    ],
    "objective": "Take the bone adze from the Temple of the Jaguar Sun.",
    "beat": "Balam grunts at the adze and says roots grip the lowest step; dig there and keep clear of the jaguar's trail.",
    "item": "cleaning_adze",
    "reveals": [
     "balam:0"
    ]
   },
   {
    "id": "s3_block",
    "kind": "fetch",
    "target": "glyph_block",
    "requires": [
     "s2_adze"
    ],
    "objective": "Recover the hidden glyph block under the Temple of Sky.",
    "beat": "Under the sky temple stair, wedged in a crack, lies the missing block. Macaws scream overhead as you pry it free.",
    "item": "glyph_block"
   },
   {
    "id": "s4_visit",
    "kind": "visit",
    "target": "ball_court",
    "requires": [
     "s3_block"
    ],
    "objective": "Cross the Ball Court to find a macaw feather the flock dropped.",
    "beat": "The macaws have left red feathers along the sloped walls. The jaguar's tracks are fresh in the mud."
   },
   {
    "id": "s5_xoc",
    "kind": "talk",
    "target": "xoc",
    "requires": [
     "s3_block"
    ],
    "objective": "Show the block to Xoc in the Palace of Lords.",
    "beat": "Xoc reads it with shaking hands and admits he gave the wrong ritual date. He asks whether the stair should be restored or the error buried.",
    "reveals": [
     "xoc:0"
    ]
   },
   {
    "id": "s6_choose",
    "kind": "choose",
    "target": "xoc",
    "requires": [
     "s5_xoc",
     "s4_visit"
    ],
    "objective": "Decide how the dawn ritual will be restored.",
    "beat": "Set the block in the stair and sing the true date, or leave Xoc's mistake unspoken and keep the old sequence.",
    "choices": [
     {
      "label": "Restore the true date and name Xoc's error",
      "unlocks": [
       "s7_true"
      ]
     },
     {
      "label": "Keep the old sequence and say nothing",
      "unlocks": [
       "s7_quiet"
      ]
     }
    ]
   },
   {
    "id": "s7_true",
    "kind": "deliver",
    "target": "balam",
    "requires": [
     "s6_choose"
    ],
    "objective": "Deliver the glyph block to Balam to set in the stair.",
    "beat": "Balam seats the block and the stair reads whole again. At dawn Itzel sings the true date, and Xoc bows his head.",
    "item": "glyph_block"
   },
   {
    "id": "s7_quiet",
    "kind": "confront",
    "target": "itzel",
    "requires": [
     "s6_choose"
    ],
    "objective": "Tell Itzel the stair stays as it is.",
    "beat": "Itzel studies you and says nothing. The ritual is sung to the old date and the stair holds its silence."
   }
  ],
  "endings": [
   {
    "stepId": "s7_true",
    "label": "The stair is whole and the true date is sung at dawn.",
    "tone": "good"
   },
   {
    "stepId": "s7_quiet",
    "label": "The old date stands and the stair keeps its error.",
    "tone": "bitter"
   }
  ]
