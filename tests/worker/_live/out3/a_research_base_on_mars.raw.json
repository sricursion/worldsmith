 "quest": {
  "id": "silent_mast",
  "title": "The Silent Mast",
  "hook": "Three sols ago the Relay Mast went dark and Kepler lost Earth. Dust is falling, power is rationed, and nobody on the crew will climb 24 metres of slick lattice. A stranger who can fetch the right board, clip in and repair it could end their isolation.",
  "giver": "okafor",
  "steps": [
   {
    "id": "s1",
    "kind": "talk",
    "target": "okafor",
    "requires": [],
    "objective": "Hear the commander out at Hab Alpha.",
    "beat": "Okafor lays out the dead mast and the dust, and asks you to restore the link."
   },
   {
    "id": "s2",
    "kind": "fetch",
    "target": "signal_board",
    "requires": [
     "s1"
    ],
    "objective": "Collect the spare signal board from Rover Bay.",
    "beat": "Reyes grunts toward the locker; the board sits in foam beside the rover tools.",
    "item": "signal_board",
    "reveals": [
     "reyes:0"
    ]
   },
   {
    "id": "s3",
    "kind": "talk",
    "target": "tran",
    "requires": [
     "s2"
    ],
    "objective": "Ask Tran what the climb demands.",
    "beat": "Tran, pale under the dead console, admits the fault is at the top and the ladder beat them.",
    "reveals": [
     "tran:0"
    ]
   },
   {
    "id": "s4",
    "kind": "visit",
    "target": "lab_dome",
    "requires": [
     "s1"
    ],
    "objective": "Visit Lindqvist at the Geology Lab.",
    "beat": "Lindqvist points out dust piled at the mast base and mentions the sparks seen that night.",
    "reveals": [
     "lindqvist:0"
    ]
   },
   {
    "id": "s5",
    "kind": "choose",
    "target": "okafor",
    "requires": [
     "s3",
     "s4"
    ],
    "objective": "Decide how to handle the heater cut that killed the mast.",
    "beat": "The mast heater was cut to spare the reactor, and everyone knows. Someone must answer for it.",
    "choices": [
     {
      "label": "Hide the truth and just fix it",
      "unlocks": [
       "s6"
      ]
     },
     {
      "label": "Tell the crew Okafor's order caused it",
      "unlocks": [
       "s6"
      ]
     }
    ],
    "reveals": [
     "okafor:0"
    ]
   },
   {
    "id": "s6",
    "kind": "deliver",
    "target": "tran",
    "requires": [
     "s5"
    ],
    "objective": "Climb the mast and install the signal board.",
    "beat": "You clip in, climb through the dustfall, and seat the board. The console wakes.",
    "item": "signal_board"
   }
  ],
  "endings": [
   {
    "stepId": "s6",
    "label": "Kepler hears Earth again.",
    "tone": "good"
   }
  ]
 },
