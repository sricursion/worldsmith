 "quest": {
  "id": "silent_fogbells",
  "title": "The Silent Fogbells of Heartwood Hollow",
  "hook": "Three nights ago the fogbells stopped, and the mist has not lifted since. Climbers who lose the bough-marks wander the crowns until they fall or freeze. Wren is out of sleep, Oskar will not meet her eye, and the elder keeps her own counsel. Someone has to find out why the bells are silent before another climber does not come home.",
  "giver": "wren",
  "steps": [
   {
    "id": "s1",
    "kind": "talk",
    "target": "wren",
    "requires": [],
    "objective": "Hear Wren out at the Swing Market",
    "beat": "Wren says the bells hang dead and begs you to find out why before the next climbers arrive."
   },
   {
    "id": "s2",
    "kind": "talk",
    "target": "maple",
    "requires": [
     "s1"
    ],
    "objective": "Ask Maple what the tea house has heard",
    "beat": "Maple pours and talks. The clappers were wrapped in felt and taken down, and Tamsin carried them.",
    "reveals": [
     "maple:0"
    ]
   },
   {
    "id": "s3",
    "kind": "fetch",
    "target": "bell_clappers",
    "requires": [
     "s2"
    ],
    "objective": "Fetch the felted clappers from the Rootbound Stores",
    "beat": "The stump cellar is dry and cold. The clappers lie wrapped in felt, exactly where someone meant them to stay.",
    "item": "bell_clappers"
   },
   {
    "id": "s4",
    "kind": "visit",
    "target": "great_hall",
    "requires": [
     "s3"
    ],
    "objective": "Climb to the Hall of Rings and find Tamsin",
    "beat": "A spotted owl watches from the rafters as you cross the platform. Tamsin sits by the cold hearth with the ringcount ledger.",
    "reveals": [
     "tamsin:0"
    ]
   },
   {
    "id": "s5",
    "kind": "choose",
    "target": "tamsin",
    "requires": [
     "s4"
    ],
    "objective": "Decide whether to rehang the bells or keep them silent",
    "beat": "Tamsin fears the ringing draws something up the trunks at night. Climbers fear the fog. Neither fear is wrong.",
    "choices": [
     {
      "label": "Rehang the bells and ring them",
      "unlocks": [
       "s6a"
      ]
     },
     {
      "label": "Honour Tamsin and leave the bells silent",
      "unlocks": [
       "s6b"
      ]
     }
    ]
   },
   {
    "id": "s6a",
    "kind": "deliver",
    "target": "wren",
    "requires": [
     "s5"
    ],
    "objective": "Bring the clappers to Wren to rehang",
    "beat": "Wren and Oskar hang the clappers together, arguing over the rope. The first bell rolls out through the fog and the climbers answer.",
    "item": "bell_clappers"
   },
   {
    "id": "s6b",
    "kind": "talk",
    "target": "wren",
    "requires": [
     "s5"
    ],
    "objective": "Tell Wren the bells stay silent",
    "beat": "Wren takes it badly, then strings lanterns on every bridge herself. Fewer climbers come home than before."
   }
  ],
  "endings": [
   {
    "stepId": "s6a",
    "label": "The bells ring and the bridges are found again",
    "tone": "good"
   },
   {
