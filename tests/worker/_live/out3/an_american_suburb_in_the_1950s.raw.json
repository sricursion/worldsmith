 "quest": {
  "id": "number_twenty",
  "title": "The Light at Number 20",
  "hook": "Maple Court is quiet, lawns clipped, antennas aimed at the same three channels. But Number 20 has a new tenant nobody has met, and its lights burn all night. Neighbours whisper over fences and nobody knocks. You are new enough here to ask what the rest won't.",
  "giver": "dot",
  "steps": [
   {
    "id": "s1",
    "kind": "talk",
    "target": "dot",
    "requires": [],
    "objective": "Hear Dot out about the new neighbour at Number 20.",
    "beat": "Dot lowers her voice over the fence and begs someone to find out who he is.",
    "reveals": [
     "dot:0"
    ]
   },
   {
    "id": "s2",
    "kind": "fetch",
    "target": "order_slip",
    "requires": [
     "s1"
    ],
    "objective": "Pick up the Number 20 order slip at Hendry's Corner Shop.",
    "beat": "The slip lists a dozen bulbs and copper wire. Nobody lights a house like that without a reason.",
    "item": "order_slip"
   },
   {
    "id": "s3",
    "kind": "visit",
    "target": "garage",
    "requires": [
     "s2"
    ],
    "objective": "Visit Delmar's Garage and ask about the black sedan.",
    "beat": "Delmar wipes his hands and says the sedan paid cash and left a toolbox behind.",
    "reveals": [
     "delmar:0"
    ]
   },
   {
    "id": "s4",
    "kind": "fetch",
    "target": "toolbox",
    "requires": [
     "s3"
    ],
    "objective": "Take the taped toolbox from the garage.",
    "beat": "Inside is a dial radio and a hand-drawn map of the water tower.",
    "item": "toolbox"
   },
   {
    "id": "s5",
    "kind": "choose",
    "target": "walt",
    "requires": [
     "s4"
    ],
    "objective": "Decide what to do with the toolbox and the map.",
    "beat": "Walt wants it quietly handed to the authorities. Dot wants a knock on the door.",
    "choices": [
     {
      "label": "Bring the toolbox to Walt and the authorities",
      "unlocks": [
       "s6a"
      ]
     },
     {
      "label": "Knock on Number 20 and return it yourself",
      "unlocks": [
       "s6b"
      ]
     }
    ],
    "reveals": [
     "walt:0"
    ]
   },
   {
    "id": "s6a",
    "kind": "deliver",
    "target": "walt",
    "requires": [
     "s5"
    ],
    "objective": "Deliver the toolbox to Walt.",
    "beat": "Walt takes it gravely. By morning a gray sedan is parked at Number 20 and the lights go dark.",
    "item": "toolbox"
   },
   {
    "id": "s6b",
    "kind": "deliver",
    "target": "rev_cole",
    "requires": [
     "s5"
    ],
    "objective": "Give the toolbox to Reverend Cole to return in person.",
    "beat": "The Reverend carries it to Number 20 at dusk. The door opens and a tired man thanks him, and the lights burn on.",
    "item": "toolbox"
   }
  ],
  "endings": [
   {
    "stepId": "s6a",
    "label": "The street is quiet again, and nobody ever learns his name.",
    "tone": "bitter"
   },
   {
    "stepId": "s6b",
    "label": "The new neighbour comes to Sunday service and sits in the back pew.",
    "tone": "good"
   }
