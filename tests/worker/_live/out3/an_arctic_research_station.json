 "quest": {
  "id": "dark_mast",
  "title": "Borealis Goes Dark",
  "hook": "Station Borealis has been silent for three days. The radio mast is dead, supply flights are grounded, and the ice-core tech swears his readings come from a year that has not happened. You arrive in falling snow with a pack and a visor. Someone here knows why the mast failed. Nobody is saying.",
  "giver": "ingrid",
  "steps": [
   {
    "id": "s1_report",
    "kind": "talk",
    "target": "ingrid",
    "requires": [],
    "objective": "Hear Ingrid's account of the outage.",
    "beat": "Ingrid gives you the outage log. It reads 'maintenance', which the guy lines say is wrong."
   },
   {
    "id": "s2_mast",
    "kind": "visit",
    "target": "radio_mast",
    "requires": [
     "s1_report"
    ],
    "objective": "Climb to the Radio Mast and inspect it. An owl circles above.",
    "beat": "The guy lines hang slack and the relay bay is empty. A snowy owl circles overhead, watching you work.",
    "reveals": [
     "mei:0"
    ]
   },
   {
    "id": "s3_feather",
    "kind": "fetch",
    "target": "owl_feather",
    "requires": [
     "s2_mast"
    ],
    "objective": "Pick up the owl feather at the mast base.",
    "beat": "The feather is rimed with frost that hasn't melted in your hand.",
    "item": "owl_feather"
   },
   {
    "id": "s4_core",
    "kind": "fetch",
    "target": "core_sample",
    "requires": [
     "s2_mast"
    ],
    "objective": "Collect the anomalous core segment from the Core Lab.",
    "beat": "Tomas lets you take the tube. It hums faintly, nine minutes apart.",
    "item": "core_sample",
    "reveals": [
     "tomas:0"
    ]
   },
   {
    "id": "s5_choose",
    "kind": "choose",
    "target": "ingrid",
    "requires": [
     "s3_feather",
     "s4_core"
    ],
    "objective": "Decide what to tell Ingrid and the station.",
    "beat": "You hold proof the mast was sabotaged from inside and the core came from a future. Ingrid waits.",
    "choices": [
     {
      "label": "Expose the false maintenance log and fix the mast.",
      "unlocks": [
       "s6_good"
      ]
     },
     {
      "label": "Bury the core and keep the station quiet.",
      "unlocks": [
       "s6_bitter"
      ]
     }
    ],
    "reveals": [
     "ingrid:0",
     "arvid:0"
    ]
   },
   {
    "id": "s6_good",
    "kind": "deliver",
    "target": "mei",
    "requires": [
     "s5_choose"
    ],
    "objective": "Give Mei the core so she can answer the signal.",
    "beat": "Mei patches the core's tone into the dead channel. The mast carries it out and a voice replies.",
    "item": "core_sample"
   },
   {
    "id": "s6_bitter",
    "kind": "confront",
    "target": "tomas",
    "requires": [
     "s5_choose"
    ],
    "objective": "Tell Tomas the core will be sealed and forgotten.",
    "beat": "Tomas stares at you, then at the sealed tube. The mast stays dark and the readings keep repeating."
   }
  ],
  "endings": [
   {
    "stepId": "s6_good",
    "label": "The mast answers.",
    "tone": "good"
   },
   {
    "stepId": "s6_bitter",
    "label": "The ice keeps its secret.",
    "tone": "bitter"
   }
  ]
 },
