 "quest": {
  "id": "quiet_drift",
  "title": "The Quiet Drift",
  "hook": "The export line is losing pressure and nothing has sounded. You arrive on chopper day as the stranger with fresh eyes, and the crew would sooner you looked anywhere but the process deck.",
  "giver": "mcallister",
  "steps": [
   {
    "id": "s1",
    "kind": "talk",
    "target": "mcallister",
    "requires": [],
    "objective": "Hear Mac out in the control room.",
    "beat": "Mac lays out the drift, the silence of the alarms, and why he wants an outsider's view.",
    "reveals": [
     "mcallister:0"
    ]
   },
   {
    "id": "s2",
    "kind": "fetch",
    "target": "gas_badge",
    "requires": [
     "s1"
    ],
    "objective": "Collect the gas badge from the living quarters.",
    "beat": "Fiona hands it over and mentions the sweet smell on the process deck.",
    "item": "gas_badge"
   },
   {
    "id": "s3",
    "kind": "visit",
    "target": "process_deck",
    "requires": [
     "s2"
    ],
    "objective": "Walk the process module with the badge clipped on.",
    "beat": "The badge chirps by the manifold. The fulmars perched above are stained dark and watching you."
   },
   {
    "id": "s4",
    "kind": "fetch",
    "target": "feather",
    "requires": [
     "s3"
    ],
    "objective": "Pick up the stained feather by the walkway.",
    "beat": "Oil on a bird means oil on the water. The leak is outside the gauges.",
    "item": "feather"
   },
   {
    "id": "s5",
    "kind": "choose",
    "target": "mcallister",
    "requires": [
     "s4"
    ],
    "objective": "Decide how to report what you found.",
    "beat": "You can tell Mac plainly, or follow Ines to learn who has been bleeding the line.",
    "choices": [
     {
      "label": "Report to Mac",
      "unlocks": [
       "s6a"
      ]
     },
     {
      "label": "Confront Ines",
      "unlocks": [
       "s6b"
      ]
     }
    ],
    "reveals": [
     "tomas:0"
    ]
   },
   {
    "id": "s6a",
    "kind": "deliver",
    "target": "mcallister",
    "requires": [
     "s5"
    ],
    "objective": "Give Mac the feather and the badge reading.",
    "beat": "Mac shuts the line down and orders a proper inspection, and the sign-off he skipped comes out.",
    "item": "feather"
   },
   {
    "id": "s6b",
    "kind": "confront",
    "target": "ines",
    "requires": [
     "s5"
    ],
    "objective": "Face Ines at the lower rail.",
    "beat": "She admits the canisters and the supply boat, and says the real leak was already there.",
    "reveals": [
     "ines:0"
    ]
   }
  ],
  "endings": [
   {
    "stepId": "s6a",
    "label": "The line is isolated and the leak is fixed, at the cost of Mac's record.",
    "tone": "good"
   },
   {
    "stepId": "s6b",
    "label": "Ines takes the blame and the leak stays quiet a while longer.",
    "tone": "bitter"
   }
  ]
 },
