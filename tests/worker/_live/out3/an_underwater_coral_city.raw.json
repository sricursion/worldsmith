 "quest": {
  "id": "fading_spire",
  "title": "The Fading Spire",
  "hook": "The Spire of Tides is losing its colour, one ring per tide, and the wardens have run out of explanations. They need a stranger who owes no one in Corallum. Start with the warden Marisol at the Nursery and follow the grey downward.",
  "giver": "marisol",
  "steps": [
   {
    "id": "s1",
    "kind": "talk",
    "target": "marisol",
    "requires": [],
    "objective": "Hear Marisol's account of the fading.",
    "beat": "Marisol shows you the dead rings and says the water tests clean. Something is taking the colour by hand."
   },
   {
    "id": "s2",
    "kind": "visit",
    "target": "spire_hall",
    "requires": [
     "s1"
    ],
    "objective": "Inspect the base of the Spire.",
    "beat": "Fine scrape marks run along the lowest grey ring, and pale grit lies in the sand beneath."
   },
   {
    "id": "s3",
    "kind": "fetch",
    "target": "pale_flake",
    "requires": [
     "s2"
    ],
    "objective": "Collect a flake of the pale grit from the shell homes near the Spire.",
    "beat": "The same colourless grit is piled on a doorstep. Someone has been carrying it away.",
    "item": "pale_flake"
   },
   {
    "id": "s4",
    "kind": "talk",
    "target": "oshun",
    "requires": [
     "s3"
    ],
    "objective": "Ask Oshun what a scraped ring does to the Spire.",
    "beat": "Oshun hesitates, then admits a record exists: cut a ring and the polyp-bond starves every ring above it.",
    "reveals": [
     "oshun:0"
    ]
   },
   {
    "id": "s5",
    "kind": "talk",
    "target": "nara",
    "requires": [
     "s3"
    ],
    "objective": "Ask Nara about night cargo leaving the dock.",
    "beat": "Nara's ledger shows sealed crates stamped with a tide-mark, signed by Teo. She looked away and was paid for it.",
    "reveals": [
     "nara:0"
    ]
   },
   {
    "id": "s6",
    "kind": "confront",
    "target": "teo",
    "requires": [
     "s4",
     "s5"
    ],
    "objective": "Confront Teo at the Pearl Exchange.",
    "beat": "Teo's smile fails. He has been selling Spire flakes to a deepward buyer and never believed the damage would spread.",
    "reveals": [
     "teo:0"
    ]
   },
   {
    "id": "s7",
    "kind": "choose",
    "target": "marisol",
    "requires": [
     "s6"
    ],
    "objective": "Decide what happens to Teo and the stolen coral.",
    "beat": "Marisol waits on your word. The Spire can be mended only if the flakes are returned, and Teo's name is worth more alive than ruined.",
    "choices": [
     {
      "label": "Hand Teo to the wardens",
      "unlocks": [
       "s8a"
      ]
     },
     {
      "label": "Make Teo restore the coral himself",
      "unlocks": [
       "s8b"
      ]
     }
    ]
   },
   {
    "id": "s8a",
    "kind": "talk",
    "target": "marisol",
    "requires": [
     "s7"
    ],
    "objective": "Report Teo to Marisol.",
    "beat": "The wardens seize Teo's stock and the Spire is sealed, but the lost rings stay grey."
   },
   {
    "id": "s8b",
    "kind": "visit",
    "target": "spire_hall",
    "requires": [
     "s7"
    ],
    "objective": "Watch Teo graft the flakes back at the Spire.",
    "beat": "Teo grafts what he can salvage. Colour creeps back up the rings, slowly, and the Exchange loses its best broker."
   }
